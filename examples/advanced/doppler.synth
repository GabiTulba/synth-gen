(* Doppler fly-by: a 220 Hz + 440 Hz saw pair passes the listener
   rapidly - the whole pass lasts a couple of seconds - left to right.

   Built on the shared Effects.Doppler technique at a 0.25 Hz pass rate
   (half-period = 2 s): `swept_saw` bends each harmonic proportionally
   to its own frequency (real Doppler shifts are relative, ~+8% -> -8%
   here), `proximity` swells the loudness to a peak at the pass
   (1 - shape^2 = sin^2), and `pan` moves the image across the stereo
   field. *)

open Core

import Effects
module D = Effects.Doppler

let source : Scalar Signal =
  let tone : Scalar Signal =
    D.swept_saw ~base:220.0 ~rate:0.25 ~depth:0.08 ~gain:0.4 * 0.55
    + D.swept_saw ~base:440.0 ~rate:0.25 ~depth:0.08 ~gain:0.4 * 0.45 in
  tone * D.proximity 0.25
;;

let doppler : Vector Signal =
  D.pan source 0.25 * 1.5
;;

let _ =
  doppler |> sample ~from:0s ~to:2s
          |> render ~name:"doppler" ~rate:48000.0 ;;
let _ =
  doppler |> sample ~from:0s ~to:2s
          |> render_vis ~name:"doppler-wave" ~rate:48000.0 ;;
