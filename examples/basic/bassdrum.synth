(* Bass drum: a soft, round 55 Hz note with a ~250 ms ADSR shape -
   a really quick 25 ms attack, quick decay to a low sustain, and a
   quick release starting at 200 ms (so the note ends at 250 ms) -
   plus a short, dark noise layer riding only on the attack. soft_clip
   rounds the sum off gently. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

let bass_drum : Scalar Signal =
  let env : Scalar Signal =
    adsr ~attack:25ms ~decay:60ms ~sustain:0.5 ~release:50ms ~hold:200ms in
  let tone : Scalar Signal = sine 55.0 *. env in
  let attack_noise : Scalar Signal =
    (noise 700.0 |> lowpass ~cutoff:900.0) *. exp_decay 45.0 *. 0.18 in
  tone *. 0.7 +. attack_noise |> soft_clip ~threshold:0.8
;;

let _ =
  bass_drum |> sample ~from:0s ~to:300ms
            |> render ~name:"bass-drum" ~rate:48000.0 ;;
let _ =
  bass_drum |> sample ~from:0s ~to:300ms
            |> render_vis ~name:"bass-drum-wave" ~rate:48000.0 ;;
