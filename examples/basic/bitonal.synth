(* Bitonal sawtooth: two saw tones 4 Hz apart (220 + 224 Hz), which beat
   against each other at 4 Hz, with a 2 Hz sine amplitude modulation
   riding on top. *)

open Core

let modded : Scalar Signal =
  let bitone : Scalar Signal = (saw 220.0 + saw 224.0) * 0.5 in
  bitone |> am ~modulator:(sine 2.0) ~depth:0.5
;;

let _ =
  modded * 0.5 |> sample ~from:0s ~to:10s
               |> render ~name:"bitonal-saw" ~rate:48000.0 ;;
let _ =
  modded * 0.5 |> sample ~from:0s ~to:10s
               |> render_vis ~name:"bitonal-saw-wave" ~rate:48000.0 ;;
