(* Guitar pluck (G3): additive harmonics where higher partials both start
   quieter and die faster, plus a tiny noise transient for the pick. *)

let harm freq:Scalar amp:Scalar decay:Scalar : Scalar Signal =
  (sine freq) * (exp_decay decay) * amp
;;

let body : Scalar Signal =
  mix_all [harm 196.0 1.0 2.6;
           harm 392.0 0.55 3.4;
           harm 588.0 0.30 4.4;
           harm 784.0 0.18 5.6;
           harm 980.0 0.10 6.8;
           harm 1176.0 0.06 8.0]
;;

let pick : Scalar Signal = (noise 3000.0) * (exp_decay 70.0) * 0.15 ;;
let guitar : Scalar Signal = body * 0.55 + pick ;;

let _ = render "guitar-pluck" 48000.0 (sample guitar 0s 2s) ;;
let _ = render_vis "guitar-pluck-wave" 48000.0 (sample guitar 0s 2s) ;;
