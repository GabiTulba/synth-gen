(* Guitar pluck (G3): additive harmonics where higher partials both start
   quieter and die faster, plus a tiny noise transient for the pick.
   Built on the shared additive partial from Voices.Keys. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Voices
module K = Voices.Keys

(* `harm` is a local function over the shared partial: it fixes the G3
   fundamental once, so the stack below reads as harmonic numbers. *)
let guitar : Scalar Signal =
  let harm ~n:Scalar ~amp:Scalar ~decay:Scalar : Scalar Signal =
    K.partial ~freq:(196.0 *. n) ~amp:amp ~decay:decay in
  let body : Scalar Signal =
    mix_all [harm ~n:1.0 ~amp:1.0 ~decay:2.6;
             harm ~n:2.0 ~amp:0.55 ~decay:3.4;
             harm ~n:3.0 ~amp:0.30 ~decay:4.4;
             harm ~n:4.0 ~amp:0.18 ~decay:5.6;
             harm ~n:5.0 ~amp:0.10 ~decay:6.8;
             harm ~n:6.0 ~amp:0.06 ~decay:8.0] in
  let pick : Scalar Signal = noise 3000.0 *. exp_decay 70.0 *. 0.15 in
  body *. 0.55 +. pick
;;

let _ =
  guitar |> sample ~from:0s ~to:2s
         |> render ~name:"guitar-pluck" ~rate:48000.0 ;;
let _ =
  guitar |> sample ~from:0s ~to:2s
         |> render_vis ~name:"guitar-pluck-wave" ~rate:48000.0 ;;
