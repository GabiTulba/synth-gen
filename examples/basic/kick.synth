(* Kick drum: an FM sine whose pitch falls fast from ~170 Hz down to
   50 Hz (the modulator is a decaying envelope, in Hz), plus a soft
   noise click at the very start. A preset over the shared Voices core. *)

open Core

import Voices

let kick : Scalar Signal =
  (Voices.Drums.kick ~carrier:50.0 ~drop_rate:25.0 ~drop_depth:120.0
                     ~body_decay:7.0 ~click_freq:4000.0 ~click_decay:90.0
                     ~click_amp:0.3) * 0.7
;;

let _ =
  kick |> sample ~from:0s ~to:500ms
       |> render ~name:"kick" ~rate:48000.0 ;;
let _ =
  kick |> sample ~from:0s ~to:500ms
       |> render_vis ~name:"kick-wave" ~rate:48000.0 ;;
