(* Snare drum: a bright noise rattle over a short tonal body. A preset
   over the shared Voices core. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Voices

let snare : Scalar Signal =
  (Voices.Drums.snare ~tone:185.0 ~tone_decay:18.0 ~tone_amp:0.5
                      ~noise_freq:1800.0 ~noise_decay:22.0) * 0.6
;;

let _ =
  snare |> sample ~from:0s ~to:350ms
        |> render ~name:"snare" ~rate:48000.0 ;;
let _ =
  snare |> sample ~from:0s ~to:350ms
        |> render_vis ~name:"snare-wave" ~rate:48000.0 ;;
