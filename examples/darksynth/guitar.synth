(* Distorted guitar: detuned saws plus a sub square driven hard into a
   hard clipper. `chug` is the palm-muted eighth; `stab` the open,
   brighter accent note - both `gated`, so the envelope and the window
   agree by construction. *)

open Core
open Core.Dsp
open Core.Pitch

(* The detune widths are cents, like the bass's: 20.7 cents is the
   grind of a doubled guitar track, and it reads as an interval rather
   than as 1.012. The sub is a plain octave down, so it stays a ratio. *)
let dist freq:Scalar : Scalar Signal =
  saw freq + saw (detune ~freq:freq ~cents:20.651)
    + square (freq * 0.5) * 0.5
    |> lowpass ~cutoff:750.0
    |> hard_clip ~threshold:0.45
;;

let chug freq:Scalar : Scalar Sample =
  dist freq
    |> gated ~attack:2ms ~decay:70ms ~sustain:0.3 ~release:40ms
             ~hold:140ms
;;

(* No clean octave partial here - a pure upper harmonic rings piano-like.
   Three detuned saws clipped hard snarl instead. *)
let stab freq:Scalar : Scalar Sample =
  saw freq + saw (detune ~freq:freq ~cents:34.283)
    + saw (detune ~freq:freq ~cents:(-6.939))
    |> lowpass ~cutoff:1400.0
    |> hard_clip ~threshold:0.35
    |> gated ~attack:2ms ~decay:120ms ~sustain:0.4 ~release:120ms
             ~hold:260ms
;;
