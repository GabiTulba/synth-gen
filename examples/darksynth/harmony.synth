(* The song's key, in one place - the tonal half of what timing.synth is
   to the clock. A harmonic minor at A = 440: the raised seventh is the
   whole reason this track sounds the way it does, and naming the mode
   says so once instead of leaving a G# to be spotted in a chord.

   Am -> F -> Dm -> E is i - VI - iv - V, four triads the key already
   contains. Every pitched part below - pad, bass, guitar, bells - takes
   its notes from here, so transposing the track is editing `tonic` and
   re-tuning it is editing `tuning`. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math
open Core.Pitch
open Core.Scale

let key : Scale = { tonic = { pc = A; oct = 2 }; quality = HarmMinor } ;;
let tuning : Tuning = et12 ~ref_hz:440.0 ;;

(* Two bars per chord, four chords to the 16 s cycle. *)
let cycle : Int list = [0; 5; 3; 4] ;;
let chord_degree ~i:Int : Int = List.nth ~xs:cycle ~i:i ~default:0 ;;

(* The same key in another register: a lead line is written in degrees
   around its own tonic, not around the pad's. *)
let octave ~oct:Int : Scale =
  { tonic = { pc = key.tonic.pc; oct = oct }; quality = key.quality } ;;

(* `count` parts of chord `i`, spread upwards from the lowest octave at
   or above `low`. Voicing from a fixed floor rather than from each
   chord's own octave is what keeps the cycle inside a fifth instead of
   climbing away as the degrees rise. *)
let parts ~i:Int ~low:Note ~count:Int : Note list =
  Scale.voicing ~notes:(Scale.triad ~s:key ~degree:(chord_degree ~i:i))
                ~low:low ~count:count ;;

(* The chord's root alone, folded into the same register - the bass, the
   guitar and the bells each ask for it at their own `low`. *)
let root ~i:Int ~low:Note : Note =
  List.nth ~xs:(Scale.voicing
                  ~notes:[Scale.degree ~s:key ~n:(chord_degree ~i:i)]
                  ~low:low ~count:1)
           ~i:0 ~default:key.tonic ;;
let root_hz ~i:Int ~low:Note : Scalar =
  hz ~t:tuning ~note:(root ~i:i ~low:low) ;;
