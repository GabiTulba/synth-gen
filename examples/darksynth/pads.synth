(* Dark pad: wide detuned saws per chord tone (the shared Voices.Pads
   tone) plus a quiet upper octave, lowpassed under a slow envelope.
   Detune is a parameter so each stereo side runs a different width. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Timing
import Voices
module P = Voices.Pads

open Core.Pitch

let note pc:PitchClass oct:Int : Scalar = a440 ~note:{ pc = pc; oct = oct } ;;

let dark_chord ~root:Scalar ~third:Scalar ~fifth:Scalar ~detune:Scalar
    : Scalar Signal =
  let env : Scalar Signal =
    adsr ~attack:600ms ~decay:400ms ~sustain:0.8 ~release:900ms
         ~hold:3100ms in
  let stack : Scalar Signal =
    (P.detuned ~freq:root ~detune:detune
     + P.detuned ~freq:third ~detune:detune
     + P.detuned ~freq:fifth ~detune:detune
     + P.detuned ~freq:(root * 2.0) ~detune:(detune * 2.0) * 0.4) * 0.27 in
  (stack |> lowpass ~cutoff:850.0) * env
;;

(* Am -> F -> Dm -> E: two bars per chord, four chords to the cycle. The
   E major (G#) is the harmonic-minor turn that makes it dark.
   `segment` is a local function that captures the enclosing detune and
   cuts each chord to the grid Timing defines, so only the chord tones
   vary per call. *)
let cycle detune:Scalar : Scalar Signal =
  let segment ~root:Scalar ~third:Scalar ~fifth:Scalar : Scalar Sample =
    dark_chord ~root:root ~third:third ~fifth:fifth ~detune:detune
      |> sample ~from:0s ~to:Timing.segment in
  let am : Scalar Sample =
    segment ~root:(note A 2) ~third:(note C 3) ~fifth:(note E 3) in
  let f : Scalar Sample =
    segment ~root:(note F 2) ~third:(note A 2) ~fifth:(note C 3) in
  let dm : Scalar Sample =
    segment ~root:(note D 2) ~third:(note F 2) ~fifth:(note A 2) in
  let e : Scalar Sample =
    segment ~root:(note E 2) ~third:(note Gs 2) ~fifth:(note B 2) in
  P.place4 ~t:Timing.tempo am f dm e
;;
