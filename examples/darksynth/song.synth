(* Darksynth: ~120 s at 120 BPM (beat 500ms, bar 2s), A minor with the
   harmonic-minor E. Three drops.

   0-16s    INTRO      blinking alarm pluck over pad + held bass; a
                       gentle riser announces the mild drums entrance
   16-32s   BUILD      four-floor kick, hats, bass eighths, snare roll,
                       riser from 28s; everything cuts at 31.5s (the gap)
   32-48s   DROP 1     the drums drop: full kit + octave-pumping grind
                       bass, deliberately no guitar - held back
   48-64s   BREAKDOWN  pad + held bass; two far-off bell tolls
                       foreshadow the end; engine Doppler at 54s, kick
                       re-enters 56s, riser from 60s
   64-88s   DROP 2     the full wall: sixteenth grind bursts, guitar
                       chugs + lead runs, sixteenth hats
   88-96s   TOLLING    bells toll the chord roots over held bass and
                       rattling chains; an engine Doppler at 89s, kick
                       re-enters 92s, riser from 91.5s
   96-112s  DROP 3     the biggest wall: sixteenth grind at both ends,
                       chugs + lead runs, chain accents on the offbeats,
                       a bell marking every chord turn; the last bar
                       gallops on a double-time kick
   112-120s OUTRO      the long quiet fall: half-gain pad, soft held
                       bass, dying bell tolls and chain echoes; a last
                       engine Doppler crosses the field *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Drums
import Bass
import Pads
import Guitar
import Fx

import Voices
module Seq = Voices.Seq

(* ---------- drums ---------- *)
(* Each line binds a local function for its groove: the hit, grid and
   spread are written once, and the mix reads as the arrangement. *)
let kick_line : Scalar Signal =
  let four_floor ~start:Timestamp ~count:Int ~seed:Scalar : Scalar Signal =
    Seq.humanized Drums.kick_hit ~start:start ~step:500ms ~count:count
      ~seed:seed ~spread:3ms in
  mix_all [four_floor ~start:16s ~count:31 ~seed:41.0;
           four_floor ~start:32s ~count:32 ~seed:42.0;
           four_floor ~start:56s ~count:15 ~seed:43.0;
           four_floor ~start:64s ~count:48 ~seed:44.0;
           four_floor ~start:92s ~count:7 ~seed:45.0;
           four_floor ~start:96s ~count:32 ~seed:46.0;
           (* the last bar gallops at double time *)
           Seq.humanized Drums.kick_hit ~start:108250ms ~step:250ms
             ~count:15 ~seed:47.0 ~spread:3ms]
;;

let snare_line : Scalar Signal =
  let roll ~start:Timestamp ~seed:Scalar : Scalar Signal =
    Seq.humanized Drums.snare_hit ~start:start ~step:250ms ~count:6
      ~seed:seed ~spread:4ms in
  let backbeat ~start:Timestamp ~count:Int ~seed:Scalar : Scalar Signal =
    Seq.humanized Drums.snare_hit ~start:start ~step:1s ~count:count
      ~seed:seed ~spread:5ms in
  mix_all [roll ~start:30s ~seed:31.0;
           backbeat ~start:32500ms ~count:16 ~seed:32.0;
           roll ~start:62s ~seed:33.0;
           backbeat ~start:64500ms ~count:24 ~seed:34.0;
           roll ~start:94s ~seed:35.0;
           backbeat ~start:96500ms ~count:16 ~seed:36.0]
;;

let hat_line : Scalar Signal =
  let run ~start:Timestamp ~step:Timestamp ~count:Int ~seed:Scalar
      : Scalar Signal =
    Seq.humanized Drums.hat_hit ~start:start ~step:step ~count:count
      ~seed:seed ~spread:8ms in
  mix_all [run ~start:16s ~step:250ms ~count:62 ~seed:21.0;
           run ~start:32250ms ~step:500ms ~count:32 ~seed:22.0;
           run ~start:64250ms ~step:250ms ~count:94 ~seed:23.0;
           run ~start:96250ms ~step:250ms ~count:62 ~seed:24.0]
;;

let drum_line : Scalar Signal =
  kick_line + snare_line * 0.85 + hat_line * 0.4
;;

(* ---------- alarm: blinking pluck through the intro ---------- *)
(* A strong blink on the second, a weaker one on the offbeat, and a
   touch of slap delay. *)
let alarm_line : Scalar Signal =
  let blink at:Timestamp : Scalar Signal =
    Seq.pattern Fx.alarm_hit ~start:at ~step:1s ~count:14 in
  let dry : Scalar Signal = blink 0s + blink 500ms * 0.45 in
  dry + (dry |> delay ~by:250ms) * 0.3
;;

(* ---------- bass (roots: A1, F1, D2, E1) ---------- *)
(* The grooves are local functions of the line that uses them. `eighths`
   drives the build. The drops run the hard-clipped grind voice: the
   first chord segment right after each drop hit runs `sixteenths` - the
   most aggressive bar of the song - and the remaining segments `pump`:
   root on the beat, octave on the offbeat, which keeps the low end
   moving instead of looping. *)
let bass_line : Scalar Signal =
  let eighths ~freq:Scalar ~start:Timestamp ~count:Int ~seed:Scalar
      : Scalar Signal =
    Seq.humanized (Bass.pulse freq) ~start:start ~step:250ms ~count:count
      ~seed:seed ~spread:5ms in
  let sixteenths ~freq:Scalar ~start:Timestamp ~seed:Scalar
      : Scalar Signal =
    Seq.humanized (Bass.grind freq) ~start:start ~step:125ms ~count:32
      ~seed:seed ~spread:4ms in
  let pump ~freq:Scalar ~start:Timestamp ~offstart:Timestamp ~seed:Scalar
      : Scalar Signal =
    Seq.humanized (Bass.grind freq) ~start:start ~step:500ms ~count:8
      ~seed:seed ~spread:5ms
    + Seq.humanized (Bass.grind (freq * 2.0)) ~start:offstart ~step:500ms
        ~count:8 ~seed:(seed + 0.5) ~spread:5ms in
  let intro : Scalar Signal =
    mix_all [place_multi (Bass.held 55.0) [0s; 2s];
             place_multi (Bass.held 43.65) [4s; 6s];
             place_multi (Bass.held 73.42) [8s; 10s];
             place_multi (Bass.held 41.2) [12s; 14s]] in
  let build : Scalar Signal =
    mix_all [eighths ~freq:55.0 ~start:16s ~count:16 ~seed:1.0;
             eighths ~freq:43.65 ~start:20s ~count:16 ~seed:2.0;
             eighths ~freq:73.42 ~start:24s ~count:16 ~seed:3.0;
             eighths ~freq:41.2 ~start:28s ~count:14 ~seed:4.0] in
  let drop1 : Scalar Signal =
    mix_all [pump ~freq:55.0 ~start:32s ~offstart:32250ms ~seed:5.0;
             pump ~freq:43.65 ~start:36s ~offstart:36250ms ~seed:6.0;
             pump ~freq:73.42 ~start:40s ~offstart:40250ms ~seed:7.0;
             pump ~freq:41.2 ~start:44s ~offstart:44250ms ~seed:8.0] in
  let breakdown : Scalar Signal =
    mix_all [place_multi (Bass.held 55.0) [48s; 50s];
             place_multi (Bass.held 43.65) [52s; 54s];
             place_multi (Bass.held 73.42) [56s; 58s];
             place_multi (Bass.held 41.2) [60s; 62s]] in
  let drop2 : Scalar Signal =
    mix_all [sixteenths ~freq:55.0 ~start:64s ~seed:9.0;
             pump ~freq:43.65 ~start:68s ~offstart:68250ms ~seed:10.0;
             pump ~freq:73.42 ~start:72s ~offstart:72250ms ~seed:11.0;
             pump ~freq:41.2 ~start:76s ~offstart:76250ms ~seed:12.0;
             pump ~freq:55.0 ~start:80s ~offstart:80250ms ~seed:13.0;
             sixteenths ~freq:43.65 ~start:84s ~seed:14.0] in
  let tolling : Scalar Signal =
    mix_all [place_multi (Bass.held 55.0) [88s; 90s];
             Bass.held 43.65 |> place ~at:92s;
             Bass.held 41.2 |> place ~at:94s] in
  let drop3 : Scalar Signal =
    mix_all [sixteenths ~freq:55.0 ~start:96s ~seed:15.0;
             pump ~freq:43.65 ~start:100s ~offstart:100250ms ~seed:16.0;
             pump ~freq:73.42 ~start:104s ~offstart:104250ms ~seed:17.0;
             sixteenths ~freq:41.2 ~start:108s ~seed:18.0] in
  let outro : Scalar Signal =
    place_multi (Bass.held 55.0) [112s; 114s; 116s] in
  intro * 0.8 + build + drop1 + breakdown * 0.8 + drop2
    + tolling * 0.8 + drop3 + outro * 0.55
;;

(* ---------- pads: the 16 s cycle tiles the whole song ---------- *)
let pad_line detune:Scalar : Scalar Signal =
  let one_cycle : Scalar Sample =
    Pads.cycle detune |> sample ~from:0s ~to:16s in
  place_multi one_cycle [0s; 16s; 32s; 48s; 64s; 80s; 96s]
  + (one_cycle |> place ~at:112s) * 0.5
;;

(* ---------- distorted guitar (drops only) ---------- *)
(* Guitar is a drop-2 weapon: drop 1 stays drums-and-bass so the second
   drop lands harder. `chugs` is a local function: twelve palm-muted
   eighths (three beats), leaving the segment tail to the lead run. *)
let chug_part : Scalar Signal =
  let chugs ~freq:Scalar ~start:Timestamp ~seed:Scalar : Scalar Signal =
    Seq.humanized (Guitar.chug freq) ~start:start ~step:250ms ~count:12
      ~seed:seed ~spread:7ms in
  mix_all [chugs ~freq:110.0 ~start:64s ~seed:61.0;
           chugs ~freq:87.31 ~start:68s ~seed:62.0;
           chugs ~freq:73.42 ~start:72s ~seed:63.0;
           chugs ~freq:82.41 ~start:76s ~seed:64.0;
           chugs ~freq:110.0 ~start:80s ~seed:65.0;
           chugs ~freq:87.31 ~start:84s ~seed:66.0;
           chugs ~freq:110.0 ~start:96s ~seed:67.0;
           chugs ~freq:87.31 ~start:100s ~seed:68.0;
           chugs ~freq:73.42 ~start:104s ~seed:69.0;
           chugs ~freq:82.41 ~start:108s ~seed:70.0]
;;

(* Lead runs: four syncopated notes at the tail of each chord segment
   (n1 . n2 . n3 . n2), answering the bass instead of two static hits.
   Drop 1 runs rise; drop 2 flips the contour downward for variation.
   `run` is a local function of the only part that plays them. *)
let stab_part : Scalar Signal =
  let run ~n1:Scalar ~n2:Scalar ~n3:Scalar
          ~at1:Timestamp ~ats2:(Timestamp list) ~at3:Timestamp
          ~seed:Scalar
      : Scalar Signal =
    place_multi (Guitar.stab n1) ([at1] |> jitter ~seed:seed ~spread:6ms)
    + place_multi (Guitar.stab n2) (ats2 |> jitter ~seed:(seed + 0.3) ~spread:6ms)
    + place_multi (Guitar.stab n3) ([at3] |> jitter ~seed:(seed + 0.7) ~spread:6ms) in
  mix_all [run ~n1:329.63 ~n2:261.63 ~n3:220.0
               ~at1:66500ms ~ats2:[67s; 67500ms] ~at3:67250ms ~seed:71.0;
           run ~n1:349.23 ~n2:261.63 ~n3:220.0
               ~at1:70500ms ~ats2:[71s; 71500ms] ~at3:71250ms ~seed:72.0;
           run ~n1:293.66 ~n2:220.0 ~n3:174.61
               ~at1:74500ms ~ats2:[75s; 75500ms] ~at3:75250ms ~seed:73.0;
           run ~n1:246.94 ~n2:207.65 ~n3:164.81
               ~at1:78500ms ~ats2:[79s; 79500ms] ~at3:79250ms ~seed:74.0;
           run ~n1:220.0 ~n2:261.63 ~n3:329.63
               ~at1:82500ms ~ats2:[83s; 83500ms] ~at3:83250ms ~seed:75.0;
           run ~n1:349.23 ~n2:261.63 ~n3:220.0
               ~at1:86500ms ~ats2:[87s; 87500ms] ~at3:87250ms ~seed:76.0;
           run ~n1:329.63 ~n2:261.63 ~n3:220.0
               ~at1:98500ms ~ats2:[99s; 99500ms] ~at3:99250ms ~seed:77.0;
           run ~n1:349.23 ~n2:261.63 ~n3:220.0
               ~at1:102500ms ~ats2:[103s; 103500ms] ~at3:103250ms ~seed:78.0;
           run ~n1:293.66 ~n2:220.0 ~n3:174.61
               ~at1:106500ms ~ats2:[107s; 107500ms] ~at3:107250ms ~seed:79.0;
           run ~n1:246.94 ~n2:329.63 ~n3:440.0
               ~at1:110500ms ~ats2:[111s; 111500ms] ~at3:111250ms ~seed:80.0]
;;

(* ---------- bells: far-off tolls that close in ---------- *)
(* Foreshadowed quietly in the first breakdown, tolling the chord roots
   through 88-96s, marking every chord turn under drop 3, then dying
   away through the outro (the last, lowest toll rings past the end). *)
let bell_part : Scalar Signal =
  let toll freq:Scalar ~at:Timestamp : Scalar Signal =
    Fx.bell_hit freq |> place ~at:at in
  let foreshadow : Scalar Signal =
    toll 220.0 ~at:48s + toll 164.81 ~at:56s in
  let tolling : Scalar Signal =
    mix_all [toll 220.0 ~at:88s; toll 174.61 ~at:90s;
             toll 146.83 ~at:92s; toll 164.81 ~at:94s] in
  let drop3 : Scalar Signal =
    mix_all [toll 220.0 ~at:96s; toll 174.61 ~at:100s;
             toll 146.83 ~at:104s; toll 164.81 ~at:108s] in
  let outro : Scalar Signal =
    toll 220.0 ~at:112s
    + toll 220.0 ~at:116s * 0.6
    + toll 110.0 ~at:118s * 0.45 in
  foreshadow * 0.5 + tolling * 0.75 + drop3 * 0.55 + outro * 0.7
;;

(* ---------- chains: industrial rattle ---------- *)
(* Loose shakes through the tolling section, offbeat accents locked to
   the bar grid under drop 3, then a single dying shake echoing away in
   the outro. *)
let chain_part : Scalar Signal =
  let tolling : Scalar Signal =
    place_multi Fx.chain_shake [89s; 91s; 93500ms; 95s] in
  let drop3 : Scalar Signal =
    Seq.pattern Fx.chain_shake ~start:96250ms ~step:2s ~count:8 in
  let outro : Scalar Signal =
    let dying : Scalar Signal = Fx.chain_shake |> place ~at:112500ms in
    dying + (dying |> delay ~by:700ms) * 0.5
          + (dying |> delay ~by:1400ms) * 0.25 in
  tolling * 0.5 + drop3 * 0.7 + outro * 0.4
;;

(* ---------- fx ---------- *)
(* The first riser is gentler - the drums entrance it announces is the
   mildest arrival of the song. *)
let fx_line : Scalar Signal =
  (Fx.riser |> place ~at:11500ms) * 0.55
  + place_multi Fx.riser [27500ms; 59500ms; 91500ms]
  + place_multi Fx.impact [32s; 64s; 88s; 96s; 112s]
;;

(* ---------- stereo buses & master ---------- *)
let drum_bus : Vector Signal =
  channels [drum_line * 0.62; drum_line * 0.62] ;;
let bass_bus : Vector Signal =
  channels [bass_line * 0.55; bass_line * 0.55] ;;
let pad_bus : Vector Signal =
  channels [pad_line 0.8 * 0.38; pad_line 1.3 * 0.38] ;;
let guitar_bus : Vector Signal =
  channels [chug_part * 0.62 + stab_part * 0.38;
            chug_part * 0.44 + stab_part * 0.55] ;;
(* Alarm sits slightly left; the stereo Doppler whooshes cross the field
   mid-breakdown and over the very end. *)
(* Bells lean right, chains lean left, alarm slightly left; the
   Doppler whooshes cross the field in each breakdown and - quieter -
   over the long outro. *)
let fx_bus : Vector Signal =
  channels [fx_line * 0.5 + alarm_line * 0.4 + bell_part * 0.3
              + chain_part * 0.42;
            fx_line * 0.5 + alarm_line * 0.28 + bell_part * 0.42
              + chain_part * 0.3]
  + (Fx.doppler_whoosh |> place ~at:54s) * 0.55
  + (Fx.doppler_whoosh |> place ~at:89s) * 0.6
  + (Fx.doppler_whoosh |> place ~at:117500ms) * 0.4 ;;

let master : Vector Signal =
  pad_bus + drum_bus + bass_bus + guitar_bus + fx_bus
    |> soft_clip ~threshold:0.9
;;

let _ =
  master |> sample ~from:0s ~to:120s
         |> render ~name:"darksynth" ~rate:48000.0 ;;

let _ =
  render_stems ~name:"darksynth" ~rate:48000.0
    ~stems:[("drums", drum_bus |> sample ~from:0s ~to:120s);
            ("bass", bass_bus |> sample ~from:0s ~to:120s);
            ("pads", pad_bus |> sample ~from:0s ~to:120s);
            ("guitar", guitar_bus |> sample ~from:0s ~to:120s);
            ("fx", fx_bus |> sample ~from:0s ~to:120s)]
;;

(* The overview image renders at a low rate: waveform lanes don't need
   audio resolution, and it keeps the build quick. *)
let _ =
  render_vis_stems ~name:"darksynth-stems-wave" ~rate:8000.0
    ~stems:[("master", master |> sample ~from:0s ~to:120s);
            ("drums", drum_bus |> sample ~from:0s ~to:120s);
            ("bass", bass_bus |> sample ~from:0s ~to:120s);
            ("pads", pad_bus |> sample ~from:0s ~to:120s);
            ("guitar", guitar_bus |> sample ~from:0s ~to:120s);
            ("fx", fx_bus |> sample ~from:0s ~to:120s)]
;;
