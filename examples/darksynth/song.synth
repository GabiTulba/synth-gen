(* Darksynth: thirty two-bar chord segments at 120 BPM in 4/4 (beat
   500ms, bar 2s, segment 4s, so ~120 s), A harmonic minor. Three drops.

   Every section below is one of `Timing`'s landmarks, and every
   position in this file is an offset from one in segments, bars or
   beats - there is not a second written down anywhere. The wall clock
   is only here to say what it sounds like.

   segment  landmark     wall clock
    0-3     intro        0-16s    blinking alarm pluck over pad + held
                                  bass; a gentle riser announces the
                                  mild drums entrance
    4-7     build        16-32s   four-floor kick, hats, bass eighths,
                                  snare roll, riser into the drop;
                                  everything cuts a beat short (the gap)
    8-11    drop1        32-48s   the drums drop: full kit +
                                  octave-pumping grind bass,
                                  deliberately no guitar - held back
   12-15    breakdown    48-64s   pad + held bass; two far-off bell
                                  tolls foreshadow the end; engine
                                  Doppler, then the kick re-enters two
                                  segments in
   16-21    drop2        64-88s   the full wall: sixteenth grind bursts,
                                  guitar chugs + lead runs, sixteenth
                                  hats
   22-23    tolling      88-96s   bells toll the chord roots over held
                                  bass and rattling chains; an engine
                                  Doppler, kick back a segment later
   24-27    drop3        96-112s  the biggest wall: sixteenth grind at
                                  both ends, chugs + lead runs, chain
                                  accents on the offbeats, a bell
                                  marking every chord turn; the last bar
                                  gallops on a double-time kick
   28-29    outro        112-120s the long quiet fall: half-gain pad,
                                  soft held bass, dying bell tolls and
                                  chain echoes; a last engine Doppler
                                  crosses the field *)

open Core
open Core.Dsp
open Core.Render

import Drums
import Bass
import Pads
import Guitar
import Fx

import Timing
import Harmony

open Core.Tempo
open Core.Pitch
open Core.Scale

(* ---------- where things are ---------- *)
(* `on Timing.drop2 1` is the second chord segment of drop 2. Every
   start below is written this way - a landmark plus a segment, a bar
   (`dur Whole`) or a beat - so nothing here has to be recomputed when
   the tempo changes. *)
let on section:Timestamp n:Int : Timestamp = section +. Timing.seg n ;;

(* ---------- what things play ---------- *)
(* Every pitch in the arrangement is a position in `Harmony.prog` -
   0 = i (Am), 1 = VI (F), 2 = iv (Dm), 3 = V (E), and the progression
   wraps, so segment n simply carries chord n - read at the register its
   part lives in. No frequency is written out below, and the four parts
   cannot drift out of agreement with each other or with the pad.

   Each `low` is the floor the root folds up to, and it is what shapes
   the line: from E1 the roots descend A1 - F1 - D2 - E1 rather than
   climbing as the degrees rise. *)
let bass_note i:Int : Scalar =
  Harmony.root_hz ~i:i ~low:{ pc = E; oct = 1 } ;;
let chug_note i:Int : Scalar =
  Harmony.root_hz ~i:i ~low:{ pc = D; oct = 2 } ;;
let bell_note i:Int : Scalar =
  Harmony.root_hz ~i:i ~low:{ pc = D; oct = 3 } ;;

(* The lead runs are melodic rather than harmonic, so they are written
   as degrees of the key around A3: 0 is the tonic, and negative degrees
   descend. Degree 6 is the raised seventh - the G# - for free. *)
let lead_note d:Int : Scalar =
  hz ~t:Harmony.tuning
     ~note:(degree ~s:(Harmony.octave ~oct:3) ~n:d) ;;

(* ---------- drums ---------- *)
(* Each line binds a local function for its groove: the hit, grid and
   spread are written once through `Groove.humanized` - jitter at the
   placement, one seed per layer - and every `count` is a number of bars
   times the hits a bar holds. *)
let kick_line : Scalar Signal =
  let four_floor ~start:Timestamp ~bars:Int ~seed:Scalar : Scalar Signal =
    Groove.humanized ~hit:Drums.kick_hit
      ~steps:(Timing.grid ~from:start ~step:Quarter
                          ~count:(bars * Timing.quarters))
      ~seed:seed ~spread:3ms in
  (* The build and the two shorter re-entries stop a beat short of what
     follows them - that silence is the gap the next section lands in. *)
  let gapped ~start:Timestamp ~bars:Int ~seed:Scalar : Scalar Signal =
    Groove.humanized ~hit:Drums.kick_hit
      ~steps:(Timing.grid ~from:start ~step:Quarter
                          ~count:(bars * Timing.quarters - 1))
      ~seed:seed ~spread:3ms in
  mix_all [gapped ~start:Timing.build ~bars:8 ~seed:41.0;
           four_floor ~start:Timing.drop1 ~bars:8 ~seed:42.0;
           gapped ~start:(on Timing.breakdown 2) ~bars:4 ~seed:43.0;
           four_floor ~start:Timing.drop2 ~bars:12 ~seed:44.0;
           gapped ~start:(on Timing.tolling 1) ~bars:2 ~seed:45.0;
           four_floor ~start:Timing.drop3 ~bars:8 ~seed:46.0;
           (* the last bar gallops at double time, on the offbeats *)
           Groove.humanized ~hit:Drums.kick_hit
             ~steps:(Timing.grid
                       ~from:(on Timing.drop3 3 +. Timing.dur Eighth)
                       ~step:Eighth ~count:(2 * Timing.eighths - 1))
             ~seed:47.0 ~spread:3ms]
;;

let snare_line : Scalar Signal =
  (* A roll fills the bar before the section it announces, six eighths
     of it; a backbeat is two to the bar, landing on beat 2 - a quarter
     after the drop hit. *)
  let roll ~before:Timestamp ~seed:Scalar : Scalar Signal =
    Groove.humanized ~hit:Drums.snare_hit
      ~steps:(Timing.grid ~from:(before -. Timing.dur Whole) ~step:Eighth
                          ~count:6)
      ~seed:seed ~spread:4ms in
  let backbeat ~start:Timestamp ~bars:Int ~seed:Scalar : Scalar Signal =
    Groove.humanized ~hit:Drums.snare_hit
      ~steps:(Timing.grid ~from:(start +. Timing.dur Quarter) ~step:Half
                          ~count:(bars * Timing.halves))
      ~seed:seed ~spread:5ms in
  mix_all [roll ~before:Timing.drop1 ~seed:31.0;
           backbeat ~start:Timing.drop1 ~bars:8 ~seed:32.0;
           roll ~before:Timing.drop2 ~seed:33.0;
           backbeat ~start:Timing.drop2 ~bars:12 ~seed:34.0;
           roll ~before:Timing.drop3 ~seed:35.0;
           backbeat ~start:Timing.drop3 ~bars:8 ~seed:36.0]
;;

let hat_line : Scalar Signal =
  (* Every run but drop 1's is eighths, and every run but the build's
     starts on the offbeat - so the hats never coincide with the kick
     that opens the section. *)
  let eighths ~start:Timestamp ~bars:Int ~seed:Scalar : Scalar Signal =
    Groove.humanized ~hit:Drums.hat_hit
      ~steps:(Timing.grid ~from:start ~step:Eighth
                          ~count:(bars * Timing.eighths - 2))
      ~seed:seed ~spread:8ms in
  let quarters ~start:Timestamp ~bars:Int ~seed:Scalar : Scalar Signal =
    Groove.humanized ~hit:Drums.hat_hit
      ~steps:(Timing.grid ~from:start ~step:Quarter
                          ~count:(bars * Timing.quarters))
      ~seed:seed ~spread:8ms in
  let off ~at:Timestamp : Timestamp = at +. Timing.dur Eighth in
  mix_all [eighths ~start:Timing.build ~bars:8 ~seed:21.0;
           quarters ~start:(off ~at:Timing.drop1) ~bars:8 ~seed:22.0;
           eighths ~start:(off ~at:Timing.drop2) ~bars:12 ~seed:23.0;
           eighths ~start:(off ~at:Timing.drop3) ~bars:8 ~seed:24.0]
;;

(* The kit's balance, the gains readable next to their parts. *)
let drum_line : Scalar Signal =
  Mix.mix ~parts:[(1.0, kick_line); (0.85, snare_line); (0.4, hat_line)]
;;

(* ---------- alarm: blinking pluck through the intro ---------- *)
(* A strong blink on the second, a weaker one on the offbeat, and a
   touch of slap delay - one `echoes` tap. Seven bars of it, two to the
   bar. *)
let alarm_line : Scalar Signal =
  let blink at:Timestamp : Scalar Signal =
    Groove.pattern ~hit:Fx.alarm_hit
                   ~steps:(Timing.grid ~from:at ~step:Half
                                       ~count:(7 * Timing.halves)) in
  let dry : Scalar Signal =
    blink Timing.intro +. blink (Timing.dur Quarter) *. 0.45 in
  echoes ~by:(Timing.dur Eighth) ~gain:0.3 ~n:1 ~input:dry
;;

(* ---------- bass (roots: A1, F1, D2, E1) ---------- *)
(* Every groove takes a section landmark and a segment inside it, and
   reads both its position and its chord off that one index - the
   progression wraps, so segment n carries chord n. `eighths` drives the
   build. The drops run the hard-clipped grind voice: the segment right
   after each drop hit runs `sixteenths` - the most aggressive bars of
   the song - and the rest `pump`: root on the beat, octave on the
   offbeat, which keeps the low end moving instead of looping. *)
let bass_line : Scalar Signal =
  (* One held note per bar of the segment. *)
  let held ~from:Timestamp ~n:Int : Scalar Signal =
    Groove.pattern ~hit:(Bass.held (bass_note n))
                   ~steps:(Timing.grid ~from:(on from n) ~step:Whole
                                       ~count:2) in
  (* `less` trims the tail, so a section can stop short of what follows
     it without the count being recomputed by hand. *)
  let eighths ~from:Timestamp ~n:Int ~less:Int ~seed:Scalar
      : Scalar Signal =
    Groove.humanized ~hit:(Bass.pulse (bass_note n))
      ~steps:(Timing.grid ~from:(on from n) ~step:Eighth
                          ~count:(2 * Timing.eighths - less))
      ~seed:seed ~spread:5ms in
  let sixteenths ~from:Timestamp ~n:Int ~seed:Scalar : Scalar Signal =
    Groove.humanized ~hit:(Bass.grind (bass_note n))
      ~steps:(Timing.grid ~from:(on from n) ~step:Sixteenth
                          ~count:(2 * Timing.sixteenths))
      ~seed:seed ~spread:4ms in
  (* The octave is derived from the root and the offbeat from the beat,
     so neither is a literal that has to keep in step with the other. *)
  let pump ~from:Timestamp ~n:Int ~seed:Scalar : Scalar Signal =
    let quarters ~at:Timestamp ~freq:Scalar ~seed:Scalar : Scalar Signal =
      Groove.humanized ~hit:(Bass.grind freq)
        ~steps:(Timing.grid ~from:at ~step:Quarter
                            ~count:(2 * Timing.quarters))
        ~seed:seed ~spread:5ms in
    quarters ~at:(on from n) ~freq:(bass_note n) ~seed:seed
    +. quarters ~at:(on from n +. Timing.dur Eighth)
               ~freq:(bass_note n *. 2.0) ~seed:(seed +. 0.5) in
  (* A section that walks all four chords of the cycle in order. *)
  let cycle ~f:(Int -> Scalar Signal) : Scalar Signal =
    mix_all (List.init ~n:4 ~f:f) in

  let intro : Scalar Signal =
    cycle ~f:(fun n:Int -> held ~from:Timing.intro ~n:n) in
  let build : Scalar Signal =
    cycle ~f:(fun n:Int ->
                eighths ~from:Timing.build ~n:n
                        (* the last segment stops two eighths short:
                           that silence is the gap the drop lands in *)
                        ~less:(if n < 3 then 0 else 2)
                        ~seed:(1.0 +. Math.to_scalar n)) in
  let drop1 : Scalar Signal =
    cycle ~f:(fun n:Int ->
                pump ~from:Timing.drop1 ~n:n
                     ~seed:(5.0 +. Math.to_scalar n)) in
  let breakdown : Scalar Signal =
    cycle ~f:(fun n:Int -> held ~from:Timing.breakdown ~n:n) in
  (* Six segments - the cycle plus its first two again - and the two
     ends of the drop are the sixteenth bursts. *)
  let drop2 : Scalar Signal =
    let seed n:Int : Scalar = 9.0 +. Math.to_scalar n in
    mix_all [sixteenths ~from:Timing.drop2 ~n:0 ~seed:(seed 0);
             pump ~from:Timing.drop2 ~n:1 ~seed:(seed 1);
             pump ~from:Timing.drop2 ~n:2 ~seed:(seed 2);
             pump ~from:Timing.drop2 ~n:3 ~seed:(seed 3);
             pump ~from:Timing.drop2 ~n:4 ~seed:(seed 4);
             sixteenths ~from:Timing.drop2 ~n:5 ~seed:(seed 5)] in
  (* Two segments only, and the second turns early: F for a bar, then
     the V that hands the drop back. *)
  let tolling : Scalar Signal =
    mix_all [held ~from:Timing.tolling ~n:0;
             Bass.held (bass_note 1) |> place ~at:(on Timing.tolling 1);
             Bass.held (bass_note 3)
               |> place ~at:(on Timing.tolling 1 +. Timing.dur Whole)] in
  let drop3 : Scalar Signal =
    let seed n:Int : Scalar = 15.0 +. Math.to_scalar n in
    mix_all [sixteenths ~from:Timing.drop3 ~n:0 ~seed:(seed 0);
             pump ~from:Timing.drop3 ~n:1 ~seed:(seed 1);
             pump ~from:Timing.drop3 ~n:2 ~seed:(seed 2);
             sixteenths ~from:Timing.drop3 ~n:3 ~seed:(seed 3)] in
  let outro : Scalar Signal =
    Groove.pattern ~hit:(Bass.held (bass_note 0))
                   ~steps:(Timing.grid ~from:Timing.outro ~step:Whole
                                       ~count:3) in
  Mix.mix ~parts:[(0.8, intro); (1.0, build); (1.0, drop1);
                  (0.8, breakdown); (1.0, drop2); (0.8, tolling);
                  (1.0, drop3); (0.55, outro)]
;;

(* ---------- pads: the four-chord cycle tiles the whole song ---------- *)
(* Eight cycles back to back, one every four segments - which is what
   makes the pad the grid every other part is cut against. The last one,
   over the outro, runs at half gain. *)
let pad_line detune:Scalar : Scalar Signal =
  let one_cycle : Scalar Sample =
    Pads.cycle detune |> sample ~from:0s ~to:(Timing.seg 4) in
  Groove.pattern ~hit:one_cycle
                 ~steps:(Time.time_steps ~start:Timing.intro
                                         ~step:(Timing.seg 4)
                                         ~count:7)
  +. (one_cycle |> place ~at:Timing.outro) *. 0.5
;;

(* ---------- distorted guitar (drops only) ---------- *)
(* Guitar is a drop-2 weapon: drop 1 stays drums-and-bass so the second
   drop lands harder. A chug run is twelve palm-muted eighths - the
   segment's sixteen less the four the lead run answers over - and, like
   the bass, it reads its chord off the segment index. *)
let chug_part : Scalar Signal =
  let chugs ~from:Timestamp ~n:Int ~seed:Scalar : Scalar Signal =
    Groove.humanized ~hit:(Guitar.chug (chug_note n))
      ~steps:(Timing.grid ~from:(on from n) ~step:Eighth
                          ~count:(2 * Timing.eighths - 4))
      ~seed:seed ~spread:7ms in
  let across ~from:Timestamp ~segs:Int ~seed:Scalar : Scalar Signal =
    mix_all (List.init ~n:segs
               ~f:(fun n:Int ->
                     chugs ~from:from ~n:n
                           ~seed:(seed +. Math.to_scalar n))) in
  across ~from:Timing.drop2 ~segs:6 ~seed:61.0
  +. across ~from:Timing.drop3 ~segs:4 ~seed:67.0
;;

(* Lead runs: four syncopated notes at the tail of each chord segment
   (d1 . d2 . d3 . d2), answering the bass instead of two static hits.
   Drop 1 runs rise; drop 2 flips the contour downward for variation.
   `run` is a local function of the only part that plays them, and it
   takes scale degrees - so a run is a shape in the key rather than
   three frequencies that have to be checked against the chord. *)
let stab_part : Scalar Signal =
  (* Every run sits at the tail of its two-bar segment, on the same
     beats: d1 on 5, d2 on 6 and 7, d3 on the offbeat between them. So
     the run takes the segment it belongs to and works out its own
     timing, instead of four literals per line that have to agree. *)
  let run ~d1:Int ~d2:Int ~d3:Int ~from:Timestamp ~n:Int ~seed:Scalar
      : Scalar Signal =
    let beat b:Scalar : Timestamp = on from n +. Timing.beats b in
    let stab d:Int : Scalar Sample = Guitar.stab (lead_note d) in
    Groove.humanized ~hit:(stab d1) ~steps:[beat 5.0]
                     ~seed:seed ~spread:6ms
    +. Groove.humanized ~hit:(stab d2) ~steps:[beat 6.0; beat 7.0]
                       ~seed:(seed +. 0.3) ~spread:6ms
    +. Groove.humanized ~hit:(stab d3) ~steps:[beat 6.5]
                       ~seed:(seed +. 0.7) ~spread:6ms in
  let d2 : Timestamp = Timing.drop2 in
  let d3 : Timestamp = Timing.drop3 in
  mix_all [run ~d1:4 ~d2:2 ~d3:0 ~from:d2 ~n:0 ~seed:71.0;
           run ~d1:5 ~d2:2 ~d3:0 ~from:d2 ~n:1 ~seed:72.0;
           run ~d1:3 ~d2:0 ~d3:(-2) ~from:d2 ~n:2 ~seed:73.0;
           run ~d1:1 ~d2:(-1) ~d3:(-3) ~from:d2 ~n:3 ~seed:74.0;
           run ~d1:0 ~d2:2 ~d3:4 ~from:d2 ~n:4 ~seed:75.0;
           run ~d1:5 ~d2:2 ~d3:0 ~from:d2 ~n:5 ~seed:76.0;
           run ~d1:4 ~d2:2 ~d3:0 ~from:d3 ~n:0 ~seed:77.0;
           run ~d1:5 ~d2:2 ~d3:0 ~from:d3 ~n:1 ~seed:78.0;
           run ~d1:3 ~d2:0 ~d3:(-2) ~from:d3 ~n:2 ~seed:79.0;
           run ~d1:1 ~d2:4 ~d3:7 ~from:d3 ~n:3 ~seed:80.0]
;;

(* ---------- bells: far-off tolls that close in ---------- *)
(* Foreshadowed quietly in the first breakdown, tolling the chord roots
   a bar apart through the tolling section, marking every chord turn
   under drop 3, then dying away through the outro (the last, lowest
   toll rings past the end). *)
let bell_part : Scalar Signal =
  let toll freq:Scalar ~at:Timestamp : Scalar Signal =
    Fx.bell_hit freq |> place ~at:at in
  (* The four chord roots in order, one every `step` - which is a bar
     when the bells are close together and a whole segment when they
     mark the turns. *)
  let peal ~from:Timestamp ~step:Timestamp : Scalar Signal =
    mix_all (List.init ~n:4
               ~f:(fun i:Int ->
                     toll (bell_note i)
                          ~at:(from +. step *. Math.to_scalar i))) in
  let foreshadow : Scalar Signal =
    toll (bell_note 0) ~at:Timing.breakdown
    +. toll (bell_note 3) ~at:(on Timing.breakdown 2) in
  let tolling : Scalar Signal =
    peal ~from:Timing.tolling ~step:(Timing.dur Whole) in
  let drop3 : Scalar Signal =
    peal ~from:Timing.drop3 ~step:(Timing.seg 1) in
  let outro : Scalar Signal =
    (* the last toll drops an octave, to the register the chugs sat in *)
    toll (bell_note 0) ~at:Timing.outro
    +. toll (bell_note 0) ~at:(on Timing.outro 1) *. 0.6
    +. toll (chug_note 0)
           ~at:(on Timing.outro 1 +. Timing.dur Whole) *. 0.45 in
  Mix.mix ~parts:[(0.5, foreshadow); (0.75, tolling); (0.55, drop3);
                  (0.7, outro)]
;;

(* ---------- chains: industrial rattle ---------- *)
(* Loose shakes through the tolling section - written as the beats they
   fall on, which is the only way an irregular gesture still follows the
   tempo - offbeat accents one to the bar under drop 3, then a single
   dying shake echoing away in the outro. *)
let chain_part : Scalar Signal =
  let tolling : Scalar Signal =
    Groove.pattern ~hit:Fx.chain_shake
                   ~steps:(List.map ~f:(fun b:Scalar ->
                                          Timing.tolling +. Timing.beats b)
                                    ~xs:[2.0; 6.0; 11.0; 14.0]) in
  let drop3 : Scalar Signal =
    Groove.pattern ~hit:Fx.chain_shake
                   ~steps:(Timing.grid
                             ~from:(Timing.drop3 +. Timing.dur Eighth)
                             ~step:Whole ~count:8) in
  let outro : Scalar Signal =
    let dying : Scalar Signal =
      Fx.chain_shake |> place ~at:(Timing.outro +. Timing.beats 1.0) in
    echoes ~by:700ms ~gain:0.5 ~n:2 ~input:dying in
  Mix.mix ~parts:[(0.5, tolling); (0.7, drop3); (0.4, outro)]
;;

(* ---------- fx ---------- *)
let fx_line : Scalar Signal =
  (* A riser ends a quarter before the arrival it announces, so it is
     placed by working back from the landmark and from its own length -
     a Sample is a record, so `to - from` is how long it runs. *)
  let riser_before at:Timestamp : Timestamp =
    at -. Timing.dur Quarter -. (Fx.riser.to -. Fx.riser.from) in
  (* The first riser is gentler - the drums entrance it announces is the
     mildest arrival of the song. *)
  (Fx.riser |> place ~at:(riser_before Timing.build)) *. 0.55
  +. Groove.pattern ~hit:Fx.riser
      ~steps:(List.map ~f:riser_before
                       ~xs:[Timing.drop1; Timing.drop2; Timing.drop3])
  +. Groove.pattern ~hit:Fx.impact
      ~steps:[Timing.drop1; Timing.drop2; Timing.tolling; Timing.drop3;
              Timing.outro]
;;

(* ---------- stereo buses & master ---------- *)
let drum_bus : Vector Signal =
  channels [drum_line *. 0.62; drum_line *. 0.62] ;;
let bass_bus : Vector Signal =
  channels [bass_line *. 0.55; bass_line *. 0.55] ;;
let pad_bus : Vector Signal =
  channels [pad_line 0.8 *. 0.38; pad_line 1.3 *. 0.38] ;;
let guitar_bus : Vector Signal =
  channels [chug_part *. 0.62 +. stab_part *. 0.38;
            chug_part *. 0.44 +. stab_part *. 0.55] ;;
(* Bells lean right, chains lean left, alarm slightly left; the
   Doppler whooshes cross the field in each breakdown and - quieter -
   over the long outro. *)
let fx_bus : Vector Signal =
  channels [fx_line *. 0.5 +. alarm_line *. 0.4 +. bell_part *. 0.3
              +. chain_part *. 0.42;
            fx_line *. 0.5 +. alarm_line *. 0.28 +. bell_part *. 0.42
              +. chain_part *. 0.3]
  +. (Fx.doppler_whoosh
       |> place ~at:(Timing.breakdown +. Timing.beats 12.0)) *. 0.55
  +. (Fx.doppler_whoosh
       |> place ~at:(Timing.tolling +. Timing.beats 2.0)) *. 0.6
  +. (Fx.doppler_whoosh
       |> place ~at:(Timing.outro +. Timing.beats 11.0)) *. 0.4 ;;

let master : Vector Signal =
  pad_bus +. drum_bus +. bass_bus +. guitar_bus +. fx_bus
    |> soft_clip ~threshold:0.9
;;

let _ =
  master |> sample ~from:0s ~to:Timing.ending
         |> render ~name:"darksynth" ~rate:48000.0 ;;

let _ =
  render_stems ~name:"darksynth" ~rate:48000.0
    ~stems:[("drums", drum_bus |> sample ~from:0s ~to:Timing.ending);
            ("bass", bass_bus |> sample ~from:0s ~to:Timing.ending);
            ("pads", pad_bus |> sample ~from:0s ~to:Timing.ending);
            ("guitar", guitar_bus |> sample ~from:0s ~to:Timing.ending);
            ("fx", fx_bus |> sample ~from:0s ~to:Timing.ending)]
;;

(* The overview image renders at a low rate: waveform lanes don't need
   audio resolution, and it keeps the build quick. *)
let _ =
  render_vis_stems ~name:"darksynth-stems-wave" ~rate:8000.0
    ~stems:[("master", master |> sample ~from:0s ~to:Timing.ending);
            ("drums", drum_bus |> sample ~from:0s ~to:Timing.ending);
            ("bass", bass_bus |> sample ~from:0s ~to:Timing.ending);
            ("pads", pad_bus |> sample ~from:0s ~to:Timing.ending);
            ("guitar", guitar_bus |> sample ~from:0s ~to:Timing.ending);
            ("fx", fx_bus |> sample ~from:0s ~to:Timing.ending)]
;;
