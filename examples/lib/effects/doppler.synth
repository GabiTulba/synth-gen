(* The Doppler fly-by technique, parametrized by pass rate.

   One control signal drives everything: `shape rate` is a cosine
   half-period (+1 at the start, -1 at the end, steepest mid-pass) made
   by giving pm a constant pi/2 phase at `rate` Hz (half-period =
   1/(2*rate) seconds). From it:
   - pitch: `swept_saw` stacks six FM partials whose deviation is
     proportional to their own frequency (real Doppler shifts are
     relative), so the whole saw sweeps coherently - a fast pass bends
     harder;
   - loudness: `proximity` = 1 - shape^2 = sin^2 (scaled), swelling to
     a peak at the pass;
   - stereo: `pan` hands the (negated) shape to Mix.pan_sig as an
     automated pan position, so the image crosses the field left to
     right under the equal-power law. *)

open Core
open Core.Osc
open Core.Arrange
open Core.Sig
open Core.Math

let shape rate:Scalar : Scalar Signal =
  pm ~carrier:rate ~modulator:(constant (pi /. 2.0)) ;;

(* A saw as a stack of six Doppler-swept FM partials: harmonic n at
   base*n with amplitude 1/n, each deviating by `depth` of its own
   frequency. `partials` is a recursive local function - it captures
   base, rate and depth from the enclosing parameters and builds the
   Cons chain that mix_all sums. *)
let swept_saw ~base:Scalar ~rate:Scalar ~depth:Scalar ~gain:Scalar
    : Scalar Signal =
  let rec partials i:Int : Scalar Signal list =
    if i >= 6 then Nil
    else
      let n : Scalar = to_scalar i +. 1.0 in
      let partial : Scalar Signal =
        (fm ~carrier:(base *. n) ~modulator:(shape rate *. (base *. n *. depth)))
          *. (1.0 /. n) in
      Cons (partial, partials (i + 1)) in
  mix_all (partials 0) *. gain
;;

let proximity rate:Scalar : Scalar Signal =
  (constant 1.0 -. shape rate *. shape rate) *. 0.85 +. 0.15
;;

(* shape runs +1 -> -1 over the pass and pan positions run -1 (left) to
   +1 (right), so the position is the shape negated. *)
let pan src:Scalar Signal rate:Scalar : Vector Signal =
  Mix.pan_sig ~pos:(shape rate *. (-1.0)) ~input:src
;;
