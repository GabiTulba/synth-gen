(* The inharmonic additive keys voice: partials run a little sharp
   (real piano strings are stiff), higher ones quieter and longer to
   bloom. `partial` is also the building block for other additive
   voices (the guitar pluck stacks it on exact harmonics). *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

let partial ~freq:Scalar ~amp:Scalar ~decay:Scalar : Scalar Signal =
  sine freq * exp_decay decay * amp
;;

let strike root:Scalar : Scalar Signal =
  mix_all [partial ~freq:root ~amp:1.0 ~decay:1.1;
           partial ~freq:(root * 2.001) ~amp:0.50 ~decay:1.6;
           partial ~freq:(root * 3.004) ~amp:0.26 ~decay:2.2;
           partial ~freq:(root * 4.009) ~amp:0.14 ~decay:2.9;
           partial ~freq:(root * 5.016) ~amp:0.07 ~decay:3.7]
;;
