(* Pad building blocks: the two-saw detuned tone every example pad is
   built from (detune is a parameter so stereo sides can run different
   widths), and the shared 4 x 4 s chord-progression placement. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

let detuned ~freq:Scalar ~detune:Scalar : Scalar Signal =
  (saw (freq - detune) + saw (freq + detune)) * 0.5
;;

(* Four chord samples on the 16 s cycle grid (four seconds each, two
   bars at 120 BPM). Polymorphic in the channel layout: placing is
   placing, whether the chords are mono or a stereo Vector. *)
let place4 a:'a Sample b:'a Sample c:'a Sample d:'a Sample
    : 'a Signal =
  mix_all [a |> place ~at:0s; b |> place ~at:4s;
           c |> place ~at:8s; d |> place ~at:12s]
;;
