(* Pad building block: the two-saw detuned tone every example pad is
   built from. Detune is a parameter so stereo sides can run different
   widths - that difference is what makes a pad feel wide.

   Placement used to live here too, as a four-chord `place4`. It does
   not any more: a progression is a `Core.Score` phrase, and `seq` lays
   four chords end to end without a library helper. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

let detuned ~freq:Scalar ~detune:Scalar : Scalar Signal =
  (saw (freq -. detune) +. saw (freq +. detune)) *. 0.5
;;
