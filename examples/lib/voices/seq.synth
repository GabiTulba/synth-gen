(* Sequencing helpers: a hit repeated on a regular grid, straight
   (`pattern`) or with humanizing timing jitter (`humanized`). The hit is
   an 'a Sample - the grid does not care whether it places mono or
   multi-channel material, so the signatures say so. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

let pattern hit:'a Sample ~start:Timestamp ~step:Timestamp ~count:Int
    : 'a Signal =
  place_multi hit (time_steps ~start:start ~step:step ~count:count)
;;

let humanized hit:'a Sample ~start:Timestamp ~step:Timestamp
              ~count:Int ~seed:Scalar ~spread:Timestamp : 'a Signal =
  place_multi hit (time_steps ~start:start ~step:step ~count:count
                     |> jitter ~seed:seed ~spread:spread)
;;
