(* Sequencing helpers - now thin, deprecated wrappers over Core.Groove,
   where the idiom was promoted. Groove.pattern/humanized take the step
   *list* itself, which composes with Tempo.grid, Tempo.swing,
   Time.jitter, Groove.mask and Groove.euclid; these wrappers keep the
   old grid-shaped signatures alive for one release of the examples and
   then go away - write new code against Core.Groove. *)

open Core
open Core.Time

let pattern hit:'a Sample ~start:Timestamp ~step:Timestamp ~count:Int
    : 'a Signal =
  Groove.pattern ~hit:hit
                 ~steps:(time_steps ~start:start ~step:step ~count:count)
;;

let humanized hit:'a Sample ~start:Timestamp ~step:Timestamp
              ~count:Int ~seed:Scalar ~spread:Timestamp : 'a Signal =
  Groove.humanized ~hit:hit
                   ~steps:(time_steps ~start:start ~step:step ~count:count)
                   ~seed:seed ~spread:spread
;;
