(* pluck.synth — the design doc's §3.4 example, in labeled-argument +
   pipe style. Builds one artifact named "demo": two seconds of audio
   containing four decaying 440 Hz plucks. *)

let pluck freq:Scalar : Scalar Signal =
  sine freq * exp_decay 6.0
;;

let pluck_sample freq:Scalar : Scalar Sample =
  pluck freq |> sample ~from:0s ~to:800ms
;;

let song : Scalar Signal =
  place_multi (pluck_sample 440.0) [0s; 500ms; 1s; 1500ms]
;;

let _ =
  song |> sample ~from:0s ~to:2s |> render ~name:"demo" ~rate:48000.0
;;
