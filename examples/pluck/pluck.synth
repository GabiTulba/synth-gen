(* pluck.synth — the design doc's §3.4 example, in labeled-argument,
   pipe and sub-let style. Builds one artifact named "demo": two seconds
   of audio containing four decaying 440 Hz plucks. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

let song : Scalar Signal =
  let pluck : Scalar Signal = sine 440.0 * exp_decay 6.0 in
  let hit : Scalar Sample = pluck |> sample ~from:0s ~to:800ms in
  place_multi hit (time_steps ~start:0s ~step:500ms ~count:4)
;;

let _ =
  song |> sample ~from:0s ~to:2s |> render ~name:"demo" ~rate:48000.0
;;
