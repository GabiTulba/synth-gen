(* primitives.synth — one short, audible render target per library
   primitive, written in labeled-argument + pipe style. Rendered
   artifacts are copied into outputs/primitives/ by
   scripts/render-outputs.sh. Levels are kept below 1.0 to avoid
   clipping in the 16-bit artifacts. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

(* Generators *)
let _ =
  sine 440.0 * 0.8 |> sample ~from:0s ~to:1s
                   |> render ~name:"sine" ~rate:48000.0 ;;
let _ =
  saw 220.0 * 0.5 |> sample ~from:0s ~to:1s
                  |> render ~name:"saw" ~rate:48000.0 ;;
let _ =
  square 220.0 * 0.4 |> sample ~from:0s ~to:1s
                     |> render ~name:"square" ~rate:48000.0 ;;
let _ =
  noise 2000.0 * 0.5 |> sample ~from:0s ~to:1s
                     |> render ~name:"noise" ~rate:48000.0 ;;

(* Envelopes *)
let _ =
  sine 440.0 * exp_decay 3.0 * 0.8
    |> sample ~from:0s ~to:1500ms
    |> render ~name:"exp_decay" ~rate:48000.0 ;;
let _ =
  sine 440.0
      * (adsr ~attack:60ms ~decay:120ms ~sustain:0.6 ~release:350ms
              ~hold:650ms)
      * 0.8
    |> sample ~from:0s ~to:1s
    |> render ~name:"adsr" ~rate:48000.0 ;;

(* Filters, on a bright source so the difference is audible *)
let _ =
  (saw 220.0 |> lowpass ~cutoff:600.0) * 0.7
    |> sample ~from:0s ~to:1s
    |> render ~name:"lowpass" ~rate:48000.0 ;;
let _ =
  (saw 220.0 |> highpass ~cutoff:2500.0) * 0.7
    |> sample ~from:0s ~to:1s
    |> render ~name:"highpass" ~rate:48000.0 ;;

(* Modulation *)
let _ =
  (fm ~carrier:220.0 ~modulator:(sine 110.0 * 180.0)) * 0.6
    |> sample ~from:0s ~to:1s
    |> render ~name:"fm" ~rate:48000.0 ;;
let _ =
  (pm ~carrier:220.0 ~modulator:(sine 110.0 * 2.5)) * 0.6
    |> sample ~from:0s ~to:1s
    |> render ~name:"pm" ~rate:48000.0 ;;
let _ =
  (sine 440.0 |> am ~modulator:(sine 4.0) ~depth:0.6) * 0.5
    |> sample ~from:0s ~to:1500ms
    |> render ~name:"am" ~rate:48000.0 ;;

(* Time effects, fed by a short blip so the tail is obvious *)
let blip : Scalar Signal =
  (sine 660.0 * exp_decay 12.0 |> sample ~from:0s ~to:250ms)
    |> place ~at:0s ;;
let _ =
  (mix_all [blip;
            (blip |> delay ~by:300ms) * 0.5;
            (blip |> delay ~by:600ms) * 0.25]) * 0.7
    |> sample ~from:0s ~to:1500ms
    |> render ~name:"delay" ~rate:48000.0 ;;
let _ =
  (blip |> reverb ~decay:900ms ~damping:0.4 ~mix:0.5) * 0.7
    |> sample ~from:0s ~to:2s
    |> render ~name:"reverb" ~rate:48000.0 ;;
(* resample: f multiplies the playback rate, so a rate that ramps from
   0.5 to 1.5 is a tape slowing down and speeding back up. *)
let _ =
  (saw 220.0 * 0.4 |> resample ~f:(fun t:Scalar -> 0.5 + t / 2.0))
    |> sample ~from:0s ~to:2s
    |> render ~name:"resample" ~rate:48000.0 ;;

(* Combination *)
let _ =
  (channels [sine 440.0; sine 443.0]) * 0.5
    |> sample ~from:0s ~to:1500ms
    |> render ~name:"channels" ~rate:48000.0 ;;
let _ =
  (mix_all [sine 261.63; sine 329.63; sine 392.0]) * 0.25
    |> sample ~from:0s ~to:1500ms
    |> render ~name:"mix_all" ~rate:48000.0 ;;

(* Distortion, on an overdriven sine so the shaping is audible *)
let hot : Scalar Signal = sine 220.0 * 3.0 ;;
let _ =
  hot |> hard_clip ~threshold:0.5
      |> sample ~from:0s ~to:1s
      |> render ~name:"hard_clip" ~rate:48000.0 ;;
let _ =
  hot |> soft_clip ~threshold:0.5
      |> sample ~from:0s ~to:1s
      |> render ~name:"soft_clip" ~rate:48000.0 ;;
let _ =
  hot |> hard_clip ~threshold:0.5
      |> sample ~from:0s ~to:20ms
      |> render_vis ~name:"hard_clip-wave" ~rate:48000.0 ;;
let _ =
  hot |> soft_clip ~threshold:0.5
      |> sample ~from:0s ~to:20ms
      |> render_vis ~name:"soft_clip-wave" ~rate:48000.0 ;;

(* List builders: List.init generating an additive harmonic stack from
   an inline lambda, and time_steps feeding place_multi with an even
   pattern. (repeat has no audible demo of its own - n copies mix to a
   plain gain change.) *)
let _ =
  mix_all (List.init 6.0 (fun i:Scalar ->
    sine (110.0 * (i + 1.0)) * (1.0 / (i + 1.0)))) * 0.3
    |> sample ~from:0s ~to:1500ms
    |> render ~name:"list_init" ~rate:48000.0 ;;

let _ =
  let tick : Scalar Sample =
    sine 880.0 * exp_decay 25.0 |> sample ~from:0s ~to:120ms in
  place_multi tick (time_steps ~start:0s ~step:250ms ~count:6.0)
    |> sample ~from:0s ~to:1600ms
    |> render ~name:"time_steps" ~rate:48000.0 ;;

(* to_sec/to_ms/to_min: the unit suffixes as functions, for durations
   that are computed rather than written. The step below is one beat at
   140 BPM - a value no literal can spell. *)
let bpm : Scalar = 140.0 ;;
let _ =
  let tick : Scalar Sample =
    sine 880.0 * exp_decay 25.0 |> sample ~from:0s ~to:(to_ms 120.0) in
  place_multi tick
    (time_steps ~start:0s ~step:(to_min (1.0 / bpm)) ~count:8.0)
    |> sample ~from:0s ~to:(to_sec (8.0 * 60.0 / bpm))
    |> render ~name:"to_sec" ~rate:48000.0 ;;

(* Signal constructors: `constant` holds a level forever (here a gain on
   a tone - a bare constant is inaudible DC); `time` is the ramp whose
   sample at t seconds is t; `signal` samples a Scalar -> Scalar
   function of time. constant_multi/signal_multi are the per-channel
   forms. *)
let _ =
  sine 440.0 * constant 0.4
    |> sample ~from:0s ~to:800ms
    |> render ~name:"constant" ~rate:48000.0 ;;

let _ =
  sine 330.0 * sqrt time * 0.5
    |> sample ~from:0s ~to:1200ms
    |> render ~name:"time" ~rate:48000.0 ;;

let _ =
  sine 440.0 * signal ~f:(fun t:Scalar -> exp (0.0 - 4.0 * t)) * 0.6
    |> sample ~from:0s ~to:1200ms
    |> render ~name:"signal_fn" ~rate:48000.0 ;;

let _ =
  channels [sine 440.0; sine 554.37] * constant_multi [0.6; 0.2]
    |> sample ~from:0s ~to:800ms
    |> render ~name:"constant_multi" ~rate:48000.0 ;;

let _ =
  channels [sine 440.0; sine 440.0]
    * signal_multi ~fs:[(fun t:Scalar -> 1.0 - t); (fun t:Scalar -> t)]
    |> sample ~from:0s ~to:1s
    |> render ~name:"signal_multi" ~rate:48000.0 ;;

(* Math: pow as a waveshaper (cubing keeps the sign, squashes the body,
   adding odd harmonics); exp/log/sqrt are the same curves audible as
   tremolo shapes. *)
let _ =
  pow (sine 220.0) 3.0
    |> sample ~from:0s ~to:800ms
    |> render ~name:"pow" ~rate:48000.0 ;;

let _ =
  sine 440.0 * exp (0.0 - 6.0 * time) * 0.6
    |> sample ~from:0s ~to:1200ms
    |> render ~name:"exp" ~rate:48000.0 ;;

let _ =
  sine 440.0 * (log (1.0 + time * 20.0) / log 21.0) * 0.5
    |> sample ~from:0s ~to:1200ms
    |> render ~name:"log" ~rate:48000.0 ;;

let _ =
  sine 440.0 * sqrt (time * 0.8) * 0.6
    |> sample ~from:0s ~to:1200ms
    |> render ~name:"sqrt" ~rate:48000.0 ;;
