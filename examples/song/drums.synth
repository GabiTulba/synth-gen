(* Drum kit for the song: each voice takes a velocity and answers with a
   finite Sample, which is exactly what `Score.strike` hands a
   percussion part - a drum has no meaningful pitch and no meaningful
   duration, so the note and the length in the score go unread. The kick
   and snare are the Basic library voices; the hat is a bright preset of
   the shared Voices core. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Basic
import Voices

let kick vel:Scalar : Scalar Sample =
  Basic.Kick.kick * vel |> sample ~from:0s ~to:400ms
;;

let snare vel:Scalar : Scalar Sample =
  Basic.Snare.snare * vel |> sample ~from:0s ~to:300ms
;;

let hat vel:Scalar : Scalar Sample =
  Voices.Drums.hat ~noise_freq:6000.0 ~cutoff:5000.0 ~decay:60.0 ~amp:0.5
    * vel
    |> sample ~from:0s ~to:120ms
;;
