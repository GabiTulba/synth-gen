(* Drum kit for the song: each hit is a finite Sample, ready for
   place_multi patterns. The kick and snare are the Basic library
   voices; the hat is a bright preset of the shared Voices core. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Basic
import Voices

let kick_hit : Scalar Sample =
  Basic.Kick.kick |> sample ~from:0s ~to:400ms
;;

let snare_hit : Scalar Sample =
  Basic.Snare.snare |> sample ~from:0s ~to:300ms
;;

let hat_hit : Scalar Sample =
  Voices.Drums.hat ~noise_freq:6000.0 ~cutoff:5000.0 ~decay:60.0 ~amp:0.5
    |> sample ~from:0s ~to:120ms
;;
