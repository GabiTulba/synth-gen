(* Piano for the song: the shared inharmonic additive voice, and the
   melody as a Score phrase - eleven degrees of the key, one note per
   half bar. Not a pitch or a position is written out: `realize` turns
   the degrees into frequencies and the beats into time, and `play`
   hands the voice each note's own length. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Timing
import Harmony
import Voices
module K = Voices.Keys

open Core.Pitch
open Core.Scale
open Core.Score

(* A voice is (freq, duration, velocity) -> Sample. The envelope's
   plateau and the sample window both follow the written length, which
   is the thing a pre-baked fixed-length note cannot express; the
   350 ms release rings on past it. *)
let piano freq:Scalar dur:Timestamp vel:Scalar : Scalar Sample =
  K.strike freq
    * (adsr ~attack:4ms ~decay:600ms ~sustain:0.25 ~release:350ms
            ~hold:dur)
    * vel
    |> sample ~from:0s ~to:(dur + 350ms)
;;

(* The tune, in scale degrees: 0 is the tonic, and negative degrees
   descend. Written this way the shape is visible - it opens on the
   tonic, works down a seventh over five bars, and lifts back to the
   seventh degree - and it stays in key under any transposition of
   `Harmony.key`. *)
let tune : Int list =
  [0; 2; 0; (-2); (-1); (-3); (-5); (-3); (-4); (-6); (-1)]
;;

(* The melody enters with the F chord at bar 2 and runs one note per
   half bar. `Ff` is a dynamic level, not a gain: Score's ladder is
   4 dB a step down from Fff = 1.0. *)
let phrase : Phrase =
  let s : Scale = Harmony.octave ~oct:4 in
  melody ~notes:(List.map ~f:(fun d:Int -> degree ~s:s ~n:d) ~xs:tune)
         ~len:2.0
    |> move ~beats:(Timing.bars 2)
    |> velocity ~f:(fun v:Scalar -> v * amp ~l:Ff)
;;

let line : Scalar Signal =
  phrase
    |> realize ~tempo:Timing.tempo ~tuning:Harmony.tuning
    |> play ~voice:piano
;;
