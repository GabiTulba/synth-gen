(* Piano for the song: the shared inharmonic additive voice, packaged
   as fixed-length note samples plus the melody line. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Timing
import Voices
module K = Voices.Keys

open Core.Pitch

let note freq:Scalar : Scalar Sample =
  let env : Scalar Signal =
    adsr ~attack:4ms ~decay:600ms ~sustain:0.25 ~release:350ms ~hold:850ms in
  K.strike freq * env * 0.6
    |> sample ~from:0s ~to:1200ms
;;

(* `key A 4` is the A above middle C, struck: the note names the pitch
   and 12-TET at A=440 turns it into a frequency. *)
let key pc:PitchClass oct:Int : Scalar Sample =
  note (a440 ~note:{ pc = pc; oct = oct }) ;;

(* The melody enters with the F chord at bar 2 and runs one note per
   half bar, on beats 1 and 3. Repeated pitches share one sample via
   place_multi. *)
let melody : Scalar Signal =
  let on ~bar:Int ~beat:Scalar : Timestamp =
    Timing.at ~bar:bar ~beat:beat in
  mix_all [place_multi (key A 4) [on ~bar:2 ~beat:0.0; on ~bar:3 ~beat:0.0];
           key C 5 |> place ~at:(on ~bar:2 ~beat:2.0);
           key F 4 |> place ~at:(on ~bar:3 ~beat:2.0);
           place_multi (key G 4) [on ~bar:4 ~beat:0.0; on ~bar:7 ~beat:0.0];
           place_multi (key E 4) [on ~bar:4 ~beat:2.0; on ~bar:5 ~beat:2.0];
           key C 4 |> place ~at:(on ~bar:5 ~beat:0.0);
           key D 4 |> place ~at:(on ~bar:6 ~beat:0.0);
           key B 3 |> place ~at:(on ~bar:6 ~beat:2.0)]
;;
