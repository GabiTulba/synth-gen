(* Background synth pad: two detuned saws per chord tone (the shared
   Voices.Pads tone), lowpassed, under a slow chord envelope. The detune
   amount is a parameter so the two stereo sides can run different
   widths - that difference is what makes the pad feel wide.

   The progression is a Score phrase: four chords of the key, eight
   beats each, laid end to end by `seq`. Nothing here is a frequency, a
   Timestamp or a chord name - `Harmony` supplies the notes and
   `realize` turns beats into time. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Timing
import Harmony
import Voices
module P = Voices.Pads

open Core.Pitch
open Core.Score

(* One chord tone, and a voice in the sense `play` means: it is handed
   the note's own written length, so the envelope's plateau and the
   sample window follow the score instead of a hardcoded 3300 ms.
   `~detune` is filled first, which leaves exactly the
   (freq, duration, velocity) function `play` wants. *)
let tone ~detune:Scalar freq:Scalar dur:Timestamp vel:Scalar
    : Scalar Sample =
  let env : Scalar Signal =
    adsr ~attack:250ms ~decay:500ms ~sustain:0.8 ~release:700ms
         ~hold:(dur - 700ms) in
  (P.detuned ~freq:freq ~detune:detune |> lowpass ~cutoff:1100.0)
    * env * vel * 0.25
    |> sample ~from:0s ~to:dur
;;

(* Am -> F -> C -> G, two bars each: four chord phrases end to end.
   Each is the triad the key gives on that degree plus its octave - four
   parts from three chord tones, which is what Scale.voicing is for. *)
let phrase : Phrase =
  seq ~ps:(List.init ~n:4
             ~f:(fun i:Int ->
                   chord ~notes:(Harmony.parts ~i:i
                                   ~low:{ pc = F; oct = 2 } ~count:4)
                         ~at:0.0 ~len:(Timing.bars 2)))
;;

let progression detune:Scalar : Scalar Signal =
  phrase
    |> realize ~tempo:Timing.tempo ~tuning:Harmony.tuning
    |> play ~voice:(tone ~detune:detune)
;;
