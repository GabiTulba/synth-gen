(* Background synth pad: two detuned saws per chord tone (the shared
   Voices.Pads tone), lowpassed, under a slow chord envelope. The detune
   amount is a parameter so the two stereo sides can run different
   widths - that difference is what makes the pad feel wide. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Voices
module P = Voices.Pads

let chord ~a:Scalar ~b:Scalar ~c:Scalar ~d:Scalar ~detune:Scalar
    : Scalar Signal =
  let env : Scalar Signal =
    adsr ~attack:250ms ~decay:500ms ~sustain:0.8 ~release:700ms
         ~hold:3300ms in
  let stack : Scalar Signal =
    (P.detuned ~freq:a ~detune:detune + P.detuned ~freq:b ~detune:detune
     + P.detuned ~freq:c ~detune:detune
     + P.detuned ~freq:d ~detune:detune) * 0.25 in
  (stack |> lowpass ~cutoff:1100.0) * env
;;

(* Am -> F -> C -> G, four seconds (two bars at 120 BPM) per chord.
   `bar` is a local function that captures the enclosing detune and cuts
   each chord to the 4 s grid, so only the chord tones vary per call. *)
let progression detune:Scalar : Scalar Signal =
  let bar ~a:Scalar ~b:Scalar ~c:Scalar ~d:Scalar : Scalar Sample =
    chord ~a:a ~b:b ~c:c ~d:d ~detune:detune
      |> sample ~from:0s ~to:4s in
  let am : Scalar Sample = bar ~a:110.0 ~b:164.81 ~c:220.0 ~d:261.63 in
  let f : Scalar Sample = bar ~a:87.31 ~b:130.81 ~c:174.61 ~d:220.0 in
  let c : Scalar Sample = bar ~a:130.81 ~b:196.0 ~c:261.63 ~d:329.63 in
  let g : Scalar Sample = bar ~a:98.0 ~b:146.83 ~c:196.0 ~d:246.94 in
  P.place4 am f c g
;;
