(* Background synth pad: two detuned saws per chord tone (the shared
   Voices.Pads tone), lowpassed, under a slow chord envelope. The detune
   amount is a parameter so the two stereo sides can run different
   widths - that difference is what makes the pad feel wide. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Timing
import Voices
module P = Voices.Pads

open Core.Tempo
open Core.Pitch

(* `note A 2` is the A two octaves below middle C, in 12-TET at A=440. *)
let note pc:PitchClass oct:Int : Scalar = a440 ~note:{ pc = pc; oct = oct } ;;

let chord ~a:Scalar ~b:Scalar ~c:Scalar ~d:Scalar ~detune:Scalar
    : Scalar Signal =
  let env : Scalar Signal =
    adsr ~attack:250ms ~decay:500ms ~sustain:0.8 ~release:700ms
         ~hold:3300ms in
  let stack : Scalar Signal =
    (P.detuned ~freq:a ~detune:detune + P.detuned ~freq:b ~detune:detune
     + P.detuned ~freq:c ~detune:detune
     + P.detuned ~freq:d ~detune:detune) * 0.25 in
  (stack |> lowpass ~cutoff:1100.0) * env
;;

(* Am -> F -> C -> G, two bars per chord. `two_bars` is a local function
   that captures the enclosing detune and cuts each chord to the grid
   Timing defines, so only the chord tones vary per call. *)
let progression detune:Scalar : Scalar Signal =
  let two_bars ~a:Scalar ~b:Scalar ~c:Scalar ~d:Scalar : Scalar Sample =
    chord ~a:a ~b:b ~c:c ~d:d ~detune:detune
      |> sample ~from:0s ~to:(Timing.at ~bar:2 ~beat:0.0) in
  let am : Scalar Sample =
    two_bars ~a:(note A 2) ~b:(note E 3) ~c:(note A 3) ~d:(note C 4) in
  let f : Scalar Sample =
    two_bars ~a:(note F 2) ~b:(note C 3) ~c:(note F 3) ~d:(note A 3) in
  let c : Scalar Sample =
    two_bars ~a:(note C 3) ~b:(note G 3) ~c:(note C 4) ~d:(note E 4) in
  let g : Scalar Sample =
    two_bars ~a:(note G 2) ~b:(note D 3) ~c:(note G 3) ~d:(note B 3) in
  P.place4 ~t:Timing.tempo am f c g
;;
