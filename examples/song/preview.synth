(* preview.synth - library-system demo. The Basic library (examples/
   basic) provides instrument voices, published by its lib.synth:
   `import Basic` gives qualified Basic.Mod.def access, `module` binds a
   shorter alias, and `open` brings one module's definitions into scope
   directly (the kick below is Basic.Kick.kick, unqualified). Requires
   "Basic" in this project's "dependencies"; the library is discovered
   from the examples/ root. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Basic
module P = Basic.Piano
open Basic.Kick

let _ =
  mix_all [place_multi (sample (P.strike 261.63) 0s 900ms) [0s; 600ms];
           place_multi (sample kick 0s 250ms)
                       (time_steps ~start:0s ~step:300ms ~count:4.0)]
  |> sample ~from:0s ~to:1200ms
  |> render ~name:"library-preview" ~rate:48000.0 ;;
