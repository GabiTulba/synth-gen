(* A full stereo song: 16 bars-worth of material at 120 BPM (beat =
   500ms, bar = 2s), Am -> F -> C -> G, two bars per chord.

   Arrangement: the pad opens alone; drums enter at bar 2 (2s), the
   piano melody at bar 3 (4s), the guitar arpeggios at bar 5 (8s).

   Stereo comes from mixing two different mono buses: the pad runs a
   different detune width per side, the piano sits a little left, the
   guitar a little right, and the drums stay centered. channels glues
   the buses into one Vector Signal and soft_clip is the master bus
   glue. *)

open Core
open Core.Dsp
open Core.Render

import Timing
import Harmony
import Drums
import Pad
import Keys
import Strings

open Core.Score

(* The groove is written as one bar and looped, the way it is counted:
   kick on every beat, snare on the backbeat, eighth hats with the
   downbeat accented. `rhythm`/`hits` build unpitched phrases -
   percussion has no pitch, and `Score.strike` never reads a note - so
   no dummy note stands in for the hits. *)
let kick_bar : Phrase = hits ~n:4 ~len:1.0 ;;

(* The backbeat is two half-note hits; the extra beat of `move` at the
   call site below is what lands them on the two-and-four. *)
let snare_bar : Phrase = hits ~n:2 ~len:2.0 ;;

(* Eight eighths with the downbeats accented: one phrase with per-step
   velocities - `vels` cycles its levels, 8 dB apart - where this used
   to take two quarter-note lines layered half a beat apart. *)
let hat_bar : Phrase =
  hits ~n:8 ~len:0.5 |> vels ~vs:[amp ~l:Fff; amp ~l:Forte] ;;

(* Kick and snare run from bar 1, the hats join a bar later; the mix
   weights sit next to their parts. *)
let drums : Scalar Signal =
  let part ~p:Phrase ~from:Scalar ~bars:Int
           ~voice:(Scalar -> Scalar Sample) : Scalar Signal =
    loop ~p:p ~n:bars
      |> move ~beats:from
      |> realize ~tempo:Timing.tempo ~tuning:Harmony.tuning
      |> strike ~voice:voice in
  Mix.mix
    ~parts:[(1.0, part ~p:kick_bar ~from:(Timing.span 1) ~bars:7
                       ~voice:Drums.kick);
            (0.9, part ~p:snare_bar ~from:(Timing.span 1 +. 1.0) ~bars:7
                       ~voice:Drums.snare);
            (0.5, part ~p:hat_bar ~from:(Timing.span 2) ~bars:6
                       ~voice:Drums.hat)]
;;

(* Per-instrument stereo buses, mixed exactly as they appear in the
   master. Keeping them as named buses is what makes stem export a
   one-liner. *)
let pad_bus : Vector Signal =
  channels [Pad.progression 0.9 *. 0.5; Pad.progression 1.4 *. 0.5] ;;
let drum_bus : Vector Signal =
  channels [drums *. 0.6; drums *. 0.6] ;;
let keys_bus : Vector Signal =
  channels [Keys.line *. 0.6; Keys.line *. 0.45] ;;
let strings_bus : Vector Signal =
  channels [Strings.riff *. 0.3; Strings.riff *. 0.45] ;;

(* The eight bars of material plus a beat of tail, so the pad's release
   and the last piano note ring out instead of being cut. *)
let ending : Timestamp = Timing.at ~bar:8 ~beat:1.0 ;;

let master : Vector Signal =
  pad_bus +. drum_bus +. keys_bus +. strings_bus
    |> soft_clip ~threshold:0.9
;;

let _ =
  master |> sample ~from:0s ~to:ending
         |> render ~name:"song" ~rate:48000.0 ;;
let _ =
  master |> sample ~from:0s ~to:ending
         |> render_vis ~name:"song-wave" ~rate:48000.0 ;;

(* Stems: one artifact per instrument bus (song-drums, song-pad,
   song-piano, song-guitar), pre-master - summing them and applying the
   soft_clip master reproduces the mix. *)
let _ =
  render_stems ~name:"song" ~rate:48000.0
    ~stems:[("drums", drum_bus |> sample ~from:0s ~to:ending);
            ("pad", pad_bus |> sample ~from:0s ~to:ending);
            ("piano", keys_bus |> sample ~from:0s ~to:ending);
            ("guitar", strings_bus |> sample ~from:0s ~to:ending)]
;;

(* One image: the master over every composing bus, on a shared time axis. *)
let _ =
  render_vis_stems ~name:"song-stems-wave" ~rate:48000.0
    ~stems:[("master", master |> sample ~from:0s ~to:ending);
            ("drums", drum_bus |> sample ~from:0s ~to:ending);
            ("pad", pad_bus |> sample ~from:0s ~to:ending);
            ("piano", keys_bus |> sample ~from:0s ~to:ending);
            ("guitar", strings_bus |> sample ~from:0s ~to:ending)]
;;
