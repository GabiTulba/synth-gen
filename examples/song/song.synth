(* A full stereo song: 16 bars-worth of material at 120 BPM (beat =
   500ms, bar = 2s), Am -> F -> C -> G, two bars per chord.

   Arrangement: the pad opens alone; drums enter at bar 2 (2s), the
   piano melody at bar 3 (4s), the guitar arpeggios at bar 5 (8s).

   Stereo comes from mixing two different mono buses: the pad runs a
   different detune width per side, the piano sits a little left, the
   guitar a little right, and the drums stay centered. channels glues
   the buses into one Vector Signal and soft_clip is the master bus
   glue. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Drums
import Pad
import Keys
import Strings

let drums : Scalar Signal =
  let kicks : Scalar Signal =
    place_multi Drums.kick_hit
                (time_steps ~start:2s ~step:500ms ~count:28.0) in
  let snares : Scalar Signal =
    place_multi Drums.snare_hit
                (time_steps ~start:2500ms ~step:1s ~count:14.0) in
  let hats : Scalar Signal =
    place_multi Drums.hat_hit
                (time_steps ~start:4s ~step:250ms ~count:48.0) in
  kicks + snares * 0.9 + hats * 0.5
;;

(* Per-instrument stereo buses, mixed exactly as they appear in the
   master. Keeping them as named buses is what makes stem export a
   one-liner. *)
let pad_bus : Vector Signal =
  channels [Pad.progression 0.9 * 0.5; Pad.progression 1.4 * 0.5] ;;
let drum_bus : Vector Signal =
  channels [drums * 0.6; drums * 0.6] ;;
let keys_bus : Vector Signal =
  channels [Keys.melody * 0.6; Keys.melody * 0.45] ;;
let strings_bus : Vector Signal =
  channels [Strings.riff * 0.3; Strings.riff * 0.45] ;;

let master : Vector Signal =
  pad_bus + drum_bus + keys_bus + strings_bus
    |> soft_clip ~threshold:0.9
;;

let _ =
  master |> sample ~from:0s ~to:16500ms
         |> render ~name:"song" ~rate:48000.0 ;;
let _ =
  master |> sample ~from:0s ~to:16500ms
         |> render_vis ~name:"song-wave" ~rate:48000.0 ;;

(* Stems: one artifact per instrument bus (song-drums, song-pad,
   song-piano, song-guitar), pre-master - summing them and applying the
   soft_clip master reproduces the mix. *)
let _ =
  render_stems ~name:"song" ~rate:48000.0
    ~stems:[("drums", drum_bus |> sample ~from:0s ~to:16500ms);
            ("pad", pad_bus |> sample ~from:0s ~to:16500ms);
            ("piano", keys_bus |> sample ~from:0s ~to:16500ms);
            ("guitar", strings_bus |> sample ~from:0s ~to:16500ms)]
;;

(* One image: the master over every composing bus, on a shared time axis. *)
let _ =
  render_vis_stems ~name:"song-stems-wave" ~rate:48000.0
    ~stems:[("master", master |> sample ~from:0s ~to:16500ms);
            ("drums", drum_bus |> sample ~from:0s ~to:16500ms);
            ("pad", pad_bus |> sample ~from:0s ~to:16500ms);
            ("piano", keys_bus |> sample ~from:0s ~to:16500ms);
            ("guitar", strings_bus |> sample ~from:0s ~to:16500ms)]
;;
