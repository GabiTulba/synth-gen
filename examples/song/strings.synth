(* Guitar for the song: a bright pluck and a two-bar arpeggio - root,
   fifth, octave, fifth - over the chords the key gives. `arpeggio`
   cycles a note list at a fixed step, so the pattern is written once
   and each chord supplies its own notes. *)

open Core
open Core.Dsp

import Timing
import Harmony

open Core.Pitch
open Core.Score

(* A pluck rings for its own decay rather than for as long as it is
   held, so the written length only sets where the window ends. *)
let pluck freq:Scalar dur:Timestamp vel:Scalar : Scalar Sample =
  let body : Scalar Signal =
    (sine freq * 0.7 + saw freq * 0.3) * exp_decay 6.0 in
  let pick : Scalar Signal = noise 3000.0 * exp_decay 80.0 * 0.1 in
  (body + pick) * 0.8 * vel
    |> sample ~from:0s ~to:(dur + 350ms)
;;

(* Root . fifth . octave . fifth, as intervals above whichever root the
   chord hands over - so the shape moves with the harmony instead of
   being three note lists that have to agree. *)
let figure ~root:Note : Note list =
  let fifth : Note = shift ~note:root ~by:7 in
  [root; fifth; shift ~note:root ~by:12; fifth]
;;

(* Enters with the C chord at bar 4, then the G chord at bar 6: sixteen
   eighths to the two-bar segment, `seq` laying the second after the
   first. Both roots fold into the octave above G3, which is what keeps
   the C above the G rather than an octave below it. *)
let phrase : Phrase =
  let segment i:Int : Phrase =
    arpeggio ~notes:(figure ~root:(Harmony.root ~i:i
                                     ~low:{ pc = G; oct = 3 }))
             ~step:0.5 ~count:16 in
  seq ~ps:[segment 2; segment 3] |> move ~beats:(Timing.span 4)
;;

let riff : Scalar Signal =
  phrase
    |> realize ~tempo:Timing.tempo ~tuning:Harmony.tuning
    |> play ~voice:pluck
;;
