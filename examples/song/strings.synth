(* Guitar for the song: a bright pluck sample and an eighth-note
   arpeggio pattern (root . fifth . octave . fifth) built on the shared
   Voices.Seq grid helper. *)

open Core
open Core.Osc
open Core.Fx
open Core.Arrange
open Core.Render
open Core.Io
open Core.Time
open Core.Sig
open Core.Math

import Timing
import Voices
module Seq = Voices.Seq

open Core.Tempo
open Core.Pitch

let pluck freq:Scalar : Scalar Sample =
  let body : Scalar Signal =
    (sine freq * 0.7 + saw freq * 0.3) * exp_decay 6.0 in
  let pick : Scalar Signal = noise 3000.0 * exp_decay 80.0 * 0.1 in
  (body + pick) * 0.8
    |> sample ~from:0s ~to:600ms
;;

(* One two-bar arpeggio: the root and octave land on the half-note
   cycle, the fifth fills every quarter in between. *)
let arp ~root:Note ~fifth:Note ~oct:Note
        ~root_t:Timestamp ~fifth_t:Timestamp ~oct_t:Timestamp
    : Scalar Signal =
  let voice n:Note : Scalar Sample = pluck (a440 ~note:n) in
  mix_all [Seq.pattern (voice root) ~start:root_t
                       ~step:(Timing.dur Half) ~count:4;
           Seq.pattern (voice fifth) ~start:fifth_t
                       ~step:(Timing.dur Quarter) ~count:8;
           Seq.pattern (voice oct) ~start:oct_t
                       ~step:(Timing.dur Half) ~count:4]
;;

(* Enters with the C chord at bar 4: C arpeggio, then G arpeggio at bar
   6. Each voice enters half a beat after the one before it. *)
let riff : Scalar Signal =
  arp ~root:{ pc = C; oct = 4 } ~fifth:{ pc = G; oct = 4 }
      ~oct:{ pc = C; oct = 5 }
      ~root_t:(Timing.at ~bar:4 ~beat:0.0)
      ~fifth_t:(Timing.at ~bar:4 ~beat:0.5)
      ~oct_t:(Timing.at ~bar:4 ~beat:1.0)
  + arp ~root:{ pc = G; oct = 3 } ~fifth:{ pc = D; oct = 4 }
        ~oct:{ pc = G; oct = 4 }
        ~root_t:(Timing.at ~bar:6 ~beat:0.0)
        ~fifth_t:(Timing.at ~bar:6 ~beat:0.5)
        ~oct_t:(Timing.at ~bar:6 ~beat:1.0)
;;
