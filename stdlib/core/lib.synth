(* SynthGraph Core - the standard library.
   Most definitions here are `external` bindings to C++ implementations
   in the files they name, sitting beside this one - the same mechanism
   any library with external implementations uses; the List module is
   written in SynthGraph itself. This file is the single source of truth
   for Core's names and signatures.

   Core is organized into functional submodules and must be brought into
   scope explicitly: `import Core` for qualified access
   (Core.Osc.sine), `open Core` for module-qualified access (Osc.sine),
   or `open Core.Osc` for bare names (sine). *)

(* --- The core types ---------------------------------------------------
   Declared here, ambient everywhere (like the built-in type names - no
   import needed to write an annotation).

   `list` is an ordinary recursive variant: `[a; b; c]` literals are
   sugar for Cons chains, and `match` takes lists apart.

   `Signal` is abstract - an engine-backed handle with no structure to
   observe; the element type is Scalar (mono) or Vector (multichannel).
   A `Sample` is a plain record: a signal plus the window to cut from
   it, so `s.from` and `{ s with to = ... }` work like on any record. *)

type 'a list = | Nil | Cons of ('a, 'a list) ;;
type 'a Signal ;;
type 'a Sample = { sig : 'a Signal; from : Timestamp; to : Timestamp } ;;

(* --- Oscillators & modulation (oscillators.cpp) ---------------------- *)

module Osc = struct
  let sine ~freq:Scalar : Scalar Signal = external "oscillators.cpp" ;;
  let saw ~freq:Scalar : Scalar Signal = external "oscillators.cpp" ;;
  let square ~freq:Scalar : Scalar Signal = external "oscillators.cpp" ;;
  (* Deterministic pseudo-noise via cascaded FM: no RNG anywhere,
     renders stay reproducible. freq sets the spectral center. *)
  let noise ~freq:Scalar : Scalar Signal = external "oscillators.cpp" ;;
  let fm ~carrier:Scalar ~modulator:Scalar Signal : Scalar Signal =
    external "oscillators.cpp" ;;
  let pm ~carrier:Scalar ~modulator:Scalar Signal : Scalar Signal =
    external "oscillators.cpp" ;;
  let am ~carrier:'a Signal ~modulator:Scalar Signal ~depth:Scalar
      : 'a Signal = external "oscillators.cpp" ;;
end ;;

(* --- Effects, filters, envelopes (effects.cpp) ----------------------- *)

module Fx = struct
  let delay ~by:Timestamp ~signal:'a Signal : 'a Signal =
    external "effects.cpp" ;;
  (* Time warping: f is a playback-rate multiplier sampled on the
     output's time base (1.0 identity, 0.5 an octave down, 2.0 up). *)
  let resample ~input:'a Signal ~f:(Scalar -> Scalar) : 'a Signal =
    external "effects.cpp" ;;
  let reverb ~decay:Timestamp ~damping:Scalar ~mix:Scalar
      ~input:'a Signal : 'a Signal = external "effects.cpp" ;;
  let exp_decay ~rate:Scalar : Scalar Signal = external "effects.cpp" ;;
  let adsr ~attack:Timestamp ~decay:Timestamp ~sustain:Scalar
      ~release:Timestamp ~hold:Timestamp : Scalar Signal =
    external "effects.cpp" ;;
  let lowpass ~cutoff:Scalar ~input:'a Signal : 'a Signal =
    external "effects.cpp" ;;
  let highpass ~cutoff:Scalar ~input:'a Signal : 'a Signal =
    external "effects.cpp" ;;
  let hard_clip ~threshold:Scalar ~input:'a Signal : 'a Signal =
    external "effects.cpp" ;;
  let soft_clip ~threshold:Scalar ~input:'a Signal : 'a Signal =
    external "effects.cpp" ;;
end ;;

(* --- Slicing, placement, mixing (sampling.cpp) ----------------------- *)

module Arrange = struct
  let mix_all ~signals:'a Signal list : 'a Signal =
    external "sampling.cpp" ;;
  let channels ~chans:Scalar Signal list : Vector Signal =
    external "sampling.cpp" ;;
  let sample ~signal:'a Signal ~from:Timestamp ~to:Timestamp : 'a Sample =
    external "sampling.cpp" ;;
  let place ~sample:'a Sample ~at:Timestamp : 'a Signal =
    external "sampling.cpp" ;;
  let place_multi ~sample:'a Sample ~ats:Timestamp list : 'a Signal =
    external "sampling.cpp" ;;
end ;;

(* --- Render targets (render.cpp) - the language's only effect.
   Artifact names share one project-wide name space. ------------------- *)

module Render = struct
  let render ~name:String ~rate:Scalar ~sample:'a Sample : unit =
    external "render.cpp" ;;
  let render_vis ~name:String ~rate:Scalar ~sample:'a Sample : unit =
    external "render.cpp" ;;
  let render_stems ~name:String ~rate:Scalar
      ~stems:(String, 'a Sample) list : unit = external "render.cpp" ;;
  let render_vis_stems ~name:String ~rate:Scalar
      ~stems:(String, 'a Sample) list : unit = external "render.cpp" ;;
end ;;

(* --- Audio import (io.cpp) - build inputs, resolved relative to the
   source file that names them. --------------------------------------- *)

module Io = struct
  let load_mono ~path:String : Scalar Signal = external "io.cpp" ;;
  let load_multi ~path:String : Vector Signal = external "io.cpp" ;;
end ;;

(* --- List functions - written in SynthGraph ----------------------------
   Lists are Cons chains, so these are plain recursive functions; both
   map and fold walk the list front to back. *)

module List = struct
  let rec map ~f:('a -> 'b) ~xs:'a list : 'b list =
    match xs with
    | Nil -> Nil
    | Cons (x, rest) -> Cons (f x, map ~f:f ~xs:rest) ;;
  let rec fold ~f:('a -> 'b -> 'a) ~init:'a ~xs:'b list : 'a =
    match xs with
    | Nil -> init
    | Cons (x, rest) -> fold ~f:f ~init:(f init x) ~xs:rest ;;
  (* init builds [f 0; f 1; ...; f (n-1)]; counts are Ints, so the type
     system guarantees they are whole (negatives yield the empty list). *)
  let init ~n:Int ~f:(Int -> 'a) : 'a list =
    let rec go i:Int : 'a list =
      if i >= n then Nil else Cons (f i, go (i + 1)) in
    go 0 ;;
  let repeat ~n:Int ~x:'a : 'a list =
    init ~n:n ~f:(fun i:Int -> x) ;;
  (* --- Structure ------------------------------------------------------
     length, indexing and concatenation: what it takes to treat a list as
     a sequence rather than something to walk once. *)
  let rec length ~xs:'a list : Int =
    match xs with
    | Nil -> 0
    | Cons (_, rest) -> 1 + length ~xs:rest ;;
  let rec append ~xs:'a list ~ys:'a list : 'a list =
    match xs with
    | Nil -> ys
    | Cons (x, rest) -> Cons (x, append ~xs:rest ~ys:ys) ;;
  (* Out-of-range indices answer with `default` rather than failing the
     build: there is no option type, and a partial primitive would make
     every caller carry a bounds check the list already knows. *)
  let rec nth ~xs:'a list ~i:Int ~default:'a : 'a =
    match xs with
    | Nil -> default
    | Cons (x, rest) ->
        if i <= 0 then x else nth ~xs:rest ~i:(i - 1) ~default:default ;;
  let rev ~xs:'a list : 'a list =
    fold ~f:(fun acc:'a list x:'a -> Cons (x, acc)) ~init:Nil ~xs:xs ;;
  (* --- Selection and expansion --------------------------------------- *)
  let rec filter ~f:('a -> Bool) ~xs:'a list : 'a list =
    match xs with
    | Nil -> Nil
    | Cons (x, rest) ->
        if f x then Cons (x, filter ~f:f ~xs:rest)
        else filter ~f:f ~xs:rest ;;
  let rec concat ~xss:'a list list : 'a list =
    match xss with
    | Nil -> Nil
    | Cons (xs, rest) -> append ~xs:xs ~ys:(concat ~xss:rest) ;;
  let rec flat_map ~f:('a -> 'b list) ~xs:'a list : 'b list =
    match xs with
    | Nil -> Nil
    | Cons (x, rest) -> append ~xs:(f x) ~ys:(flat_map ~f:f ~xs:rest) ;;
  (* zip stops at the shorter list, so pairing a melody with a rhythm
     never invents an element neither side had. *)
  let rec zip ~xs:'a list ~ys:'b list : ('a, 'b) list =
    match xs with
    | Nil -> Nil
    | Cons (x, xrest) ->
        (match ys with
         | Nil -> Nil
         | Cons (y, yrest) -> Cons ((x, y), zip ~xs:xrest ~ys:yrest)) ;;
  (* --- Numeric folds --------------------------------------------------
     `range` is the Int counterpart of time_steps; `maximum` takes the
     value an empty list answers with, which doubles as a floor. *)
  let range ~from:Int ~count:Int : Int list =
    init ~n:count ~f:(fun i:Int -> from + i) ;;
  let sum ~xs:Scalar list : Scalar =
    fold ~f:(fun acc:Scalar x:Scalar -> acc + x) ~init:0.0 ~xs:xs ;;
  let maximum ~xs:Scalar list ~least:Scalar : Scalar =
    fold ~f:(fun acc:Scalar x:Scalar -> if x > acc then x else acc)
         ~init:least ~xs:xs ;;
end ;;

(* --- Time: conversions and Timestamp sequences ------------------------
   (math.cpp for conversions, lists.cpp for the sequence builders). ----- *)

module Time = struct
  (* The computed counterpart of the literal suffixes; there is
     deliberately no conversion back from Timestamp. *)
  let to_sec ~x:Scalar : Timestamp = external "math.cpp" ;;
  let to_ms ~x:Scalar : Timestamp = external "math.cpp" ;;
  let to_min ~x:Scalar : Timestamp = external "math.cpp" ;;
  let time_steps ~start:Timestamp ~step:Timestamp ~count:Int
      : Timestamp list = external "lists.cpp" ;;
  (* Humanization: hash-derived deltas in [-spread, +spread], a pure
     function of (seed, index) - deterministic and cacheable. *)
  let jitter ~seed:Scalar ~spread:Timestamp ~steps:Timestamp list
      : Timestamp list = external "lists.cpp" ;;
end ;;

(* --- Signal constructors (signals.cpp) ------------------------------- *)

module Sig = struct
  let constant ~value:Scalar : Scalar Signal = external "signals.cpp" ;;
  let constant_multi ~levels:Scalar list : Vector Signal =
    external "signals.cpp" ;;
  (* The ramp whose sample at t seconds is t. *)
  let time : Scalar Signal = external "signals.cpp" ;;
  let signal ~f:(Scalar -> Scalar) : Scalar Signal =
    external "signals.cpp" ;;
  let signal_multi ~fs:(Scalar -> Scalar) list : Vector Signal =
    external "signals.cpp" ;;
end ;;

(* --- Math & Bool (math.cpp) ------------------------------------------ *)

module Math = struct
  (* Polymorphic over Scalars, Vectors and Signals (elementwise);
     anything else is a build-time error. Domain follows IEEE. *)
  let exp ~x:'a : 'a = external "math.cpp" ;;
  let sqrt ~x:'a : 'a = external "math.cpp" ;;
  let log ~x:'a : 'a = external "math.cpp" ;;
  let pow ~x:'a ~y:Scalar : 'a = external "math.cpp" ;;
  (* Int <-> Scalar conversions. Ints never decay implicitly; going to
     the continuous side is exact (to_scalar), coming back says how the
     fraction is dropped (round / floor / ceil). *)
  let to_scalar ~n:Int : Scalar = external "math.cpp" ;;
  let round ~x:Scalar : Int = external "math.cpp" ;;
  let floor ~x:Scalar : Int = external "math.cpp" ;;
  let ceil ~x:Scalar : Int = external "math.cpp" ;;
  (* Boolean negation; && and || are (short-circuiting) operators. *)
  let not ~b:Bool : Bool = external "math.cpp" ;;
end ;;
